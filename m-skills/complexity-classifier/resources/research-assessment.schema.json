{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform research assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "stage",
    "fit",
    "unmet_requirements",
    "summary"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["copilot", "foundry"]},
    "fit": {"enum": ["full", "partial", "not-fit"]},
    "unmet_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "evidence_ids", "reason"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"fit": {"const": "full"}}
      },
      "then": {
        "properties": {"unmet_requirements": {"maxItems": 0}}
      },
      "else": {
        "properties": {"unmet_requirements": {"minItems": 1}}
      }
    }
  ]
}
