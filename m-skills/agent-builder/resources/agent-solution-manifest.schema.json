{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft-scout.local/schemas/agent-solution-manifest.schema.json",
  "title": "Agent solution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "buildMode",
    "solutionType",
    "primaryAgentId",
    "environmentId",
    "solutionUniqueName",
    "package",
    "deploymentOrder",
    "agents",
    "relationships"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "buildMode": {"enum": ["copilot-studio-package", "cowork-configuration", "mixed", "assessment-only"]},
    "solutionType": {"enum": ["single-agent", "multi-agent"]},
    "primaryAgentId": {"type": "string", "minLength": 1},
    "environmentId": {"type": "string", "minLength": 1},
    "solutionUniqueName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "package": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath", "sha256", "bytes"],
          "properties": {
            "relativePath": {
              "type": "string",
              "pattern": "^packages/[a-z0-9]+(?:-[a-z0-9]+)*\\.zip$"
            },
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "bytes": {"type": "integer", "minimum": 1}
          }
        },
        {"type": "null"}
      ]
    },
    "deploymentOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "agentId",
          "schemaName",
          "agenticPlatform",
          "harness",
          "role",
          "state",
          "projectRelativePath",
          "instructionsSha256",
          "components"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "agentId": {"type": "string", "minLength": 1},
          "schemaName": {"type": ["string", "null"], "minLength": 1},
          "agenticPlatform": {"enum": ["Microsoft Copilot Studio", "Microsoft Cowork"]},
          "harness": {"enum": ["GitHub Copilot", "Standard", "Copilot chat", null]},
          "role": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "projectRelativePath": {
            "type": ["string", "null"],
            "pattern": "^project/[A-Za-z0-9_.-]+$"
          },
          "instructionsSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "status"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "status": {"type": "string", "minLength": 1}
              }
            },
            "allOf": [
              {
                "if": {"properties": {"agenticPlatform": {"const": "Microsoft Cowork"}}},
                "then": {"properties": {"harness": {"const": null}}}
              },
              {
                "if": {"properties": {"agenticPlatform": {"const": "Microsoft Copilot Studio"}}},
                "then": {"properties": {"harness": {"enum": ["GitHub Copilot", "Standard", "Copilot chat"]}}}
              }
            ]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceAgentId", "targetAgentId", "type", "description"],
        "properties": {
          "sourceAgentId": {"type": "string", "minLength": 1},
          "targetAgentId": {"type": "string", "minLength": 1},
          "type": {"enum": ["connected-agent", "child-agent", "workflow-call", "other"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"solutionType": {"const": "single-agent"}}
      },
      "then": {
        "properties": {
          "agents": {"maxItems": 1},
          "relationships": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"solutionType": {"const": "multi-agent"}}
      },
      "then": {
        "properties": {
          "agents": {"minItems": 2},
          "relationships": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"buildMode": {"const": "cowork-configuration"}}},
      "then": {
        "properties": {
          "package": {"type": "null"},
          "agents": {
            "items": {
              "properties": {
                "agenticPlatform": {"const": "Microsoft Cowork"},
                "harness": {"const": null}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"buildMode": {"enum": ["copilot-studio-package", "mixed"]}}},
      "then": {"properties": {"package": {"type": "object"}}}
    }
  ]
}
