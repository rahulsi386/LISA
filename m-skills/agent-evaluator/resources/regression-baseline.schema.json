{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft-scout.local/schemas/regression-baseline.schema.json",
  "title": "Agent regression baseline",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "baselineId", "approvalStatus", "createdAt", "sourceRunId", "agent", "summary", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "baselineId": {"type": "string", "minLength": 1},
    "approvalStatus": {"enum": ["candidate-unapproved", "approved", "superseded"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "sourceRunId": {
      "type": "string",
      "pattern": "^EVAL-[0-9]{8}-[0-9]{6}-[A-F0-9]{8}$"
    },
    "agent": {
      "type": "object",
      "required": ["name", "agentId", "harness", "instructionSha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "agentId": {"type": "string", "minLength": 1},
        "harness": {"enum": ["GitHub Copilot", "Standard", "Copilot chat"]},
        "instructionSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "summary": {
      "type": "object",
      "required": ["passed", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["testCaseId", "status", "scores"],
        "properties": {
          "testCaseId": {"type": "string", "pattern": "^EVAL-[0-9]{3,}$"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
          "scores": {"type": "object"}
        }
      }
    }
  }
}
