{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solution Designer normalized model",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarioSlug", "title", "summary", "complexity", "coverage", "referenceKeys", "components", "relationships", "sequence"],
  "properties": {
    "scenarioSlug": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "trustBoundaries": {"type": "array", "items": {"type": "object"}},
    "environments": {"type": "array", "items": {"type": "object"}},
    "architecturePrinciples": {"type": "array", "items": {"type": "object"}},
    "presentation": {"type": "object"},
    "allowedTools": {"type": "array", "items": {"type": "string"}},
    "pocScope": {"type": "object"},
    "productionReadinessGaps": {"type": "array", "items": {"type": "object"}},
    "capabilityAssessments": {"type": "array", "items": {"type": "object"}},
    "actionControls": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["capabilityId", "actionImpact", "pocTreatment", "buildContract"],
        "properties": {
          "capabilityId": {"type": "string"},
          "actionImpact": {"enum": ["read-only", "draft", "reversible-write", "high-impact-write", "irreversible-or-safety-critical", null]},
          "pocTreatment": {"enum": ["build", "configure", "simulate", "static-sample-data", "manual-handoff", "defer", "block"]},
          "buildContract": {"type": "object"}
        }
      }
    },
    "complexity": {"enum": ["Low", "Medium", "High"]},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nativeBuildPercent", "pocDemonstrationPercent", "unsupportedPercent", "unknownPercent"],
      "properties": {
        "nativeBuildPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "pocDemonstrationPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "unsupportedPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "unknownPercent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "sourceClassification": {"type": "string", "minLength": 1},
    "sourceClassificationSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "referenceKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "layer", "kind", "status", "implementationStatus", "buildOwner", "pocScope", "productionStatus", "iconKey", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "layer": {"enum": ["users", "channels", "agent-platform", "data-integration", "governance", "monitoring"]},
          "kind": {"enum": ["actor", "channel", "agent", "knowledge", "tool", "flow", "data", "integration", "external", "human", "security", "monitoring", "alm"]},
          "status": {"enum": ["existing", "to-create", "tbd"]},
          "implementationStatus": {"enum": ["build", "configure", "simulate", "static-sample-data", "manual-handoff", "defer", "block", "existing"]},
          "buildOwner": {"enum": ["agent-builder", "customer", "external-team", "unassigned"]},
          "pocScope": {"enum": ["included", "represented", "excluded"]},
          "productionStatus": {"enum": ["ready", "requires-hardening", "gap"]},
          "iconKey": {"type": "string", "minLength": 1},
          "description": {"type": "string", "maxLength": 1000},
          "roleDescription": {"type": "string"},
          "productService": {"type": "string"},
          "hostingRuntime": {"type": "string"},
          "deploymentBoundary": {"type": "string"},
          "componentType": {"type": "string"},
          "sourceCategory": {"type": "string"},
          "lifecycle": {"type": "string"},
          "environmentScope": {"type": "string"},
          "inventoryNames": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "visualRole": {"enum": ["primary", "supporting", "cross-cutting"]},
          "visualGroup": {"type": "string"},
          "presentation": {"type": "object"},
          "reliability": {"type": "string"},
          "scalability": {"type": "string"},
          "security": {"type": "string"},
          "allowedToolScope": {"type": "object"},
          "productionGaps": {"type": "array", "items": {"type": "object"}},
          "capabilityIds": {"type": "array", "items": {"type": "string"}},
          "referenceIds": {"type": "array", "items": {"type": "string"}},
          "sourceRefs": {"type": "array", "items": {"type": "string"}},
          "members": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "label", "style", "implementationMode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "label": {"type": "string", "minLength": 1, "maxLength": 300},
          "relationshipType": {"type": "string"},
          "direction": {"enum": ["unidirectional", "bidirectional"]},
          "integrationMethod": {"type": "string"},
          "protocol": {"type": "string"},
          "dataFlow": {"type": "string"},
          "access": {"type": "string"},
          "authentication": {"type": "string"},
          "synchronous": {"type": "boolean"},
          "failureBehavior": {"type": "string"},
          "referenceIds": {"type": "array", "items": {"type": "string"}},
          "sourceRefs": {"type": "array", "items": {"type": "string"}},
          "presentation": {"type": "object"},
          "style": {"enum": ["call", "response", "optional", "tbd"]},
          "implementationMode": {"enum": ["real", "simulated", "manual", "deferred", "blocked"]},
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "label", "type", "implementationMode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "relationshipId": {"type": ["string", "null"]},
          "condition": {"type": ["string", "null"]},
          "branchKind": {"enum": ["success", "failure", "insufficient-grounding", "rejection", "timeout", "simulation"]},
          "simulationDisclosure": {"type": ["string", "null"]},
          "actionControl": {"type": "object"},
          "referenceIds": {"type": "array", "items": {"type": "string"}},
          "sourceRefs": {"type": "array", "items": {"type": "string"}},
          "presentation": {"type": "object"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "label": {"type": "string", "minLength": 1, "maxLength": 400},
          "type": {"enum": ["call", "response", "self", "approval"]},
          "implementationMode": {"enum": ["real", "simulated", "manual", "deferred", "blocked"]},
          "capabilityId": {"type": ["string", "null"]},
          "fragment": {"type": ["string", "null"], "maxLength": 40},
          "phase": {"type": "string", "minLength": 1, "maxLength": 40},
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
