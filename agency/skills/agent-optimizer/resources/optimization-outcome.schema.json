{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lisa:agency:optimization-outcome:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "strategy", "gepa", "overallImpact"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "runId": {"type": "string", "pattern": "^OPT-[0-9]{8}-[0-9]{6}-[A-F0-9]{8}$"},
    "strategy": {"enum": ["evidence-guided", "gepa"]},
    "gepa": {"type": "object", "required": ["status"], "properties": {
      "status": {"enum": ["not-used", "not-started", "awaiting-host", "ready-for-promotion", "no-improvement", "holdout-rejected", "budget-exhausted", "blocked"]},
      "runSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }},
    "overallImpact": {"type": "object", "required": ["status", "deploymentGate", "reason"], "properties": {
      "status": {"enum": ["not-measured", "measured"]},
      "deploymentGate": {"enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"]},
      "reason": {"type": "string"}
    }}
  }
}