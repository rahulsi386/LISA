{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft-scout.local/schemas/requirement-analyzer/evidence-ledger.schema.json",
  "title": "Requirement Analyzer Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "findings",
    "source_annotations",
    "referred_artifacts",
    "manual_reviews",
    "knowledge_sources",
    "platforms",
    "platform_absence_finding_ids",
    "integrations",
    "integration_notes",
    "agentic_behaviors",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "source_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "role",
          "classification",
          "finding_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-[A-F0-9]{12}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "minLength": 1
          },
          "finding_ids": {
            "$ref": "#/$defs/findingIds"
          }
        }
      }
    },
    "referred_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "location",
          "content_type",
          "in_folder_reference",
          "match_confidence",
          "role",
          "rationale",
          "finding_ids"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "minLength": 1
          },
          "in_folder_reference": {
            "type": "string",
            "minLength": 1
          },
          "match_confidence": {
            "enum": [
              "Confirmed",
              "Probable",
              "Ambiguous",
              "Missing"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "finding_ids": {
            "$ref": "#/$defs/findingIds"
          }
        }
      }
    },
    "manual_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "status",
          "method",
          "coverage",
          "notes",
          "result",
          "observations"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "complete",
              "failed"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "evidence-observed",
              "no-evidence-observed",
              "review-failed"
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "locator",
                "text"
              ],
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "complete"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "enum": [
                    "evidence-observed",
                    "no-evidence-observed"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "const": "review-failed"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "const": "evidence-observed"
                }
              }
            },
            "then": {
              "properties": {
                "observations": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "knowledge_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledgeSource"
      }
    },
    "knowledge_source_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/textItem"
      },
      "default": []
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "platform_absence_finding_ids": {
      "$ref": "#/$defs/optionalFindingIds"
    },
    "integrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/integration"
      }
    },
    "integration_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/textItem"
      }
    },
    "agentic_behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agenticBehavior"
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Executive Summary",
        "Problem Statement",
        "Current State",
        "Desired Future State",
        "Goals",
        "Success Criteria",
        "Metrics and Baselines",
        "Data Sources",
        "Data Types",
        "Dependencies and Constraints",
        "Solution Components",
        "Scope and Delivery Phases",
        "Gaps and Conflicts"
      ],
      "properties": {
        "Executive Summary": {
          "$ref": "#/$defs/blocks"
        },
        "Problem Statement": {
          "$ref": "#/$defs/blocks"
        },
        "Current State": {
          "$ref": "#/$defs/blocks"
        },
        "Desired Future State": {
          "$ref": "#/$defs/blocks"
        },
        "Goals": {
          "$ref": "#/$defs/blocks"
        },
        "Success Criteria": {
          "$ref": "#/$defs/blocks"
        },
        "Metrics and Baselines": {
          "$ref": "#/$defs/blocks"
        },
        "Data Sources": {
          "$ref": "#/$defs/blocks"
        },
        "Data Types": {
          "$ref": "#/$defs/blocks"
        },
        "Dependencies and Constraints": {
          "$ref": "#/$defs/blocks"
        },
        "Solution Components": {
          "$ref": "#/$defs/blocks"
        },
        "Scope and Delivery Phases": {
          "$ref": "#/$defs/blocks"
        },
        "Gaps and Conflicts": {
          "$ref": "#/$defs/blocks"
        }
      }
    }
  },
  "$defs": {
    "findingIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(D-[0-9]{3,}|(REQ|OBS|CLS|GAP|CON|DEC)-[A-F0-9]{10})$"
      }
    },
    "optionalFindingIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(D-[0-9]{3,}|(REQ|OBS|CLS|GAP|CON|DEC)-[A-F0-9]{10})$"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator",
        "evidence_type"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^(SRC-[A-F0-9]{12}|EMB-[A-F0-9]{12}|CONFIG|CORPUS)$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "enum": [
            "explicit",
            "metadata",
            "derived",
            "configuration",
            "absence_check"
          ]
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "kind",
        "statement",
        "status",
        "confidence",
        "evidence"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^(D-[0-9]{3,}|(REQ|OBS|CLS|GAP|CON|DEC)-[A-F0-9]{10})$"
        },
        "kind": {
          "enum": [
            "Explicit requirement",
            "Observed fact",
            "Derived classification",
            "Analyst-identified gap",
            "Conflict",
            "Decision"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "Confirmed",
            "Current",
            "Required",
            "Preferred",
            "Candidate",
            "Strong candidate",
            "Optional",
            "Near-term",
            "Future",
            "Potential",
            "Explicitly excluded",
            "Not evidenced",
            "Unresolved"
          ]
        },
        "confidence": {
          "enum": [
            "Confirmed",
            "Probable",
            "Ambiguous",
            "Missing"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "textItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "finding_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "$ref": "#/$defs/findingIds"
        }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "finding_ids"
      ],
      "properties": {
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "finding_ids": {
          "$ref": "#/$defs/findingIds"
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "finding_ids"
          ],
          "properties": {
            "type": {
              "enum": [
                "paragraph",
                "heading3"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "finding_ids": {
              "$ref": "#/$defs/findingIds"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "enum": [
                "bullets",
                "numbered"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/textItem"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "columns",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/tableRow"
              }
            }
          }
        }
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "knowledgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "classification",
        "location",
        "source_id",
        "hosting_type",
        "content_type",
        "structure",
        "grounding_purpose",
        "authority_priority",
        "access_behavior",
        "ownership_freshness",
        "intended_use",
        "finding_ids"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "Confirmed Knowledge Source",
            "Strong Candidate Knowledge Source",
            "Configured Knowledge Source"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^(SRC-[A-F0-9]{12}|EMB-[A-F0-9]{12}|CONFIG)$"
        },
        "hosting_type": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "structure": {
          "type": "string",
          "minLength": 1
        },
        "grounding_purpose": {
          "type": "string",
          "minLength": 1
        },
        "authority_priority": {
          "type": "string",
          "minLength": 1
        },
        "access_behavior": {
          "type": "string",
          "minLength": 1
        },
        "ownership_freshness": {
          "type": "string",
          "minLength": 1
        },
        "intended_use": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "$ref": "#/$defs/findingIds"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "provider",
        "requirement_status",
        "intended_role",
        "constraints_gaps",
        "finding_ids"
      ],
      "properties": {
        "platform": {
          "enum": [
            "Copilot Studio",
            "Agent Builder",
            "Azure Foundry",
            "Pro Code",
            "Third Party Provider"
          ]
        },
        "provider": {
          "type": "string"
        },
        "requirement_status": {
          "enum": [
            "Required",
            "Preferred",
            "Candidate",
            "Current",
            "Explicitly excluded"
          ]
        },
        "intended_role": {
          "type": "string",
          "minLength": 1
        },
        "constraints_gaps": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "$ref": "#/$defs/findingIds"
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "source_system",
        "target_system",
        "purpose",
        "direction",
        "trigger_method",
        "status",
        "evidence_gaps",
        "finding_ids"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "source_system": {
          "type": "string",
          "minLength": 1
        },
        "target_system": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "trigger_method": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "evidence_gaps": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "$ref": "#/$defs/findingIds"
        }
      }
    },
    "agenticBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior",
        "requirement_status",
        "evidenced_behavior",
        "trigger_decision_handoff",
        "gaps",
        "finding_ids"
      ],
      "properties": {
        "behavior": {
          "enum": [
            "Conversational",
            "Autonomous",
            "Child-Agent/Multi-Agent",
            "Human Handoff/oversight"
          ]
        },
        "requirement_status": {
          "enum": [
            "Confirmed",
            "Candidate",
            "Current",
            "Explicitly excluded",
            "Not evidenced"
          ]
        },
        "evidenced_behavior": {
          "type": "string",
          "minLength": 1
        },
        "trigger_decision_handoff": {
          "type": "string",
          "minLength": 1
        },
        "gaps": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "$ref": "#/$defs/findingIds"
        }
      }
    }
  }
}
