{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complexity Classification Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "complexity",
    "research_stage",
    "platform_assessment",
    "agentic_platform",
    "harness",
    "code_tier",
    "counts",
    "delivery_assessment",
    "coverage",
    "platform_scores",
    "components",
    "solution_topology",
    "reference_sources",
    "justification",
    "harness_rationale",
    "billing_implication",
    "decisive_reasons",
    "gaps",
    "input_analysis",
    "output_markdown"
  ],
  "properties": {
    "complexity": {
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "research_stage": {
      "enum": ["copilot", "foundry", "agent-framework"]
    },
    "platform_assessment": {
      "type": "object"
    },
    "agentic_platform": {
      "enum": [
        "Copilot Studio",
        "Microsoft Cowork",
        "Azure AI Foundry",
        "Pro-code (Microsoft Agent Framework)",
        "Hybrid"
      ]
    },
    "harness": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "GitHub Copilot",
        "Standard",
        "Copilot chat",
        "Cowork",
        null
      ]
    },
    "code_tier": {
      "enum": [
        "No-code",
        "Low-code",
        "Pro-code"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_sources",
        "easily_integrable_tools",
        "skills",
        "connected_agents"
      ],
      "properties": {
        "knowledge_sources": {
          "type": "integer",
          "minimum": 0
        },
        "easily_integrable_tools": {
          "type": "integer",
          "minimum": 0
        },
        "skills": {
          "type": "integer",
          "minimum": 0
        },
        "connected_agents": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "delivery_assessment": {"type": "object"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_build_percent", "poc_demonstration_percent", "unsupported_percent", "unknown_percent"],
      "properties": {
        "native_build_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "poc_demonstration_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "unsupported_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "unknown_percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "platform_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product", "weighted_score"],
        "properties": {
          "product": {"type": "string", "minLength": 1},
          "weighted_score": {"type": "number", "minimum": 0, "maximum": 100}
        }
      }
    },
    "components": {
      "type": "object"
    },
    "solution_topology": {
      "type": "object"
    },
    "reference_sources": {
      "type": "array"
    },
    "justification": {
      "type": "string",
      "minLength": 1
    },
    "harness_rationale": {
      "type": "string",
      "minLength": 1
    },
    "billing_implication": {
      "type": "string",
      "minLength": 1
    },
    "decisive_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gaps": {
      "type": "array"
    },
    "input_analysis": {
      "type": "string",
      "minLength": 1
    },
    "output_markdown": {
      "type": "string",
      "minLength": 1
    }
  }
}
