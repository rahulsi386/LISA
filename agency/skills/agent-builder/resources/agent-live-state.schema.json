{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft-scout.local/schemas/agent-live-state.schema.json",
  "title": "Agent live construction state",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "runId", "capturedAt", "buildMode", "agent", "agents", "instructionsSha256", "components", "capabilities", "packages"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "runId": {"type": "string", "pattern": "^BLD-[0-9]{8}-[0-9]{6}-[A-F0-9]{8}$"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "buildMode": {"enum": ["copilot-studio-package", "cowork-configuration", "mixed", "assessment-only"]},
    "agent": {
      "type": "object",
      "required": ["name", "agentId", "schemaName", "agenticPlatform", "harness", "environmentId", "state"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "agentId": {"type": "string", "minLength": 1},
        "schemaName": {"type": ["string", "null"], "minLength": 1},
        "agenticPlatform": {"enum": ["Microsoft Copilot Studio", "Microsoft Cowork"]},
        "harness": {"enum": ["GitHub Copilot", "Standard", "Copilot chat", null]},
        "environmentId": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"agenticPlatform": {"const": "Microsoft Cowork"}}},
          "then": {"properties": {"harness": {"const": null}}}
        },
        {
          "if": {"properties": {"agenticPlatform": {"const": "Microsoft Copilot Studio"}}},
          "then": {"properties": {"harness": {"enum": ["GitHub Copilot", "Standard", "Copilot chat"]}}}
        }
      ]
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "agentId", "schemaName", "agenticPlatform", "harness", "environmentId", "state", "instructionsSha256", "components"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "agentId": {"type": "string", "minLength": 1},
          "schemaName": {"type": ["string", "null"], "minLength": 1},
          "agenticPlatform": {"enum": ["Microsoft Copilot Studio", "Microsoft Cowork"]},
          "harness": {"enum": ["GitHub Copilot", "Standard", "Copilot chat", null]},
          "environmentId": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "instructionsSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "components": {"type": "array"}
        },
        "allOf": [
          {
            "if": {"properties": {"agenticPlatform": {"const": "Microsoft Cowork"}}},
            "then": {"properties": {"harness": {"const": null}}}
          },
          {
            "if": {"properties": {"agenticPlatform": {"const": "Microsoft Copilot Studio"}}},
            "then": {"properties": {"harness": {"enum": ["GitHub Copilot", "Standard", "Copilot chat"]}}}
          }
        ]
      }
    },
    "instructionsSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1}
        }
      }
    },
    "capabilities": {"type": "object"},
    "packages": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["relativePath", "sha256", "bytes"],
        "properties": {
          "relativePath": {
            "type": "string",
            "pattern": "^packages/[a-z0-9]+(?:-[a-z0-9]+)*\\.zip$"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"buildMode": {"const": "cowork-configuration"}}},
          "then": {
            "properties": {
              "agent": {
                "properties": {
                  "agenticPlatform": {"const": "Microsoft Cowork"},
                  "harness": {"const": null}
                }
              },
              "agents": {
                "items": {
                  "properties": {
                    "agenticPlatform": {"const": "Microsoft Cowork"},
                    "harness": {"const": null}
                  }
                }
              },
              "packages": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"buildMode": {"const": "copilot-studio-package"}}},
          "then": {
            "properties": {
              "agent": {"properties": {"agenticPlatform": {"const": "Microsoft Copilot Studio"}}},
              "agents": {"items": {"properties": {"agenticPlatform": {"const": "Microsoft Copilot Studio"}}}},
              "packages": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"buildMode": {"const": "mixed"}}},
          "then": {"properties": {"packages": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"buildMode": {"const": "assessment-only"}}},
          "then": {"properties": {"packages": {"maxItems": 0}}}
        }
      ]
    }
  }
}
