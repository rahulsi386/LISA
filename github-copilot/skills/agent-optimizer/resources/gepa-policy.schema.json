{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lisa:agency:gepa-policy:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "seed", "searchMetricCalls", "maxMetricCalls", "maxReflectionCalls", "maxElapsedSeconds", "minimumImprovement", "trainIds", "validationIds", "holdoutIds", "protectedTestIds", "shadowAgent", "isolationVerified", "isolationEvidence", "reflectionApproved", "reflectionProvider", "reflectionModel"],
  "properties": {
    "enabled": {"const": true},
    "seed": {"type": "integer", "minimum": 0},
    "searchMetricCalls": {"type": "integer", "minimum": 4, "maximum": 1000},
    "maxMetricCalls": {"type": "integer", "minimum": 8, "maximum": 2000},
    "maxReflectionCalls": {"type": "integer", "minimum": 1, "maximum": 100},
    "maxElapsedSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "minimumImprovement": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "maxReflectionCostUsd": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "trainIds": {"$ref": "#/$defs/ids"},
    "validationIds": {"$ref": "#/$defs/ids"},
    "holdoutIds": {"$ref": "#/$defs/ids"},
    "protectedTestIds": {"$ref": "#/$defs/ids"},
    "shadowAgent": {
      "type": "object", "additionalProperties": false,
      "required": ["agentId", "environmentId", "harness"],
      "properties": {
        "agentId": {"type": "string", "minLength": 1},
        "environmentId": {"type": "string", "minLength": 1},
        "harness": {"enum": ["Standard", "GitHub Copilot", "Copilot chat"]}
      }
    },
    "githubCopilot": {
      "type": "object", "additionalProperties": false,
      "required": ["memoryMode", "creditsVerified"],
      "properties": {
        "memoryMode": {"enum": ["disabled", "reset-between-tests"]},
        "creditsVerified": {"const": true}
      }
    },
    "isolationVerified": {"const": true},
    "isolationEvidence": {"type": "string", "minLength": 1},
    "reflectionApproved": {"const": true},
    "reflectionProvider": {"type": "string", "minLength": 1},
    "reflectionModel": {"type": "string", "minLength": 1}
  },
  "allOf": [{
    "if": {"properties": {"shadowAgent": {"properties": {"harness": {"const": "GitHub Copilot"}}}}},
    "then": {"required": ["githubCopilot"]},
    "else": {"not": {"required": ["githubCopilot"]}}
  }],
  "$defs": {
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVAL-[0-9]{3,}$"}}
  }
}