{
  "@context": {
    "@version": 1.1,
    "@vocab": "urn:lisa:copilot:ontology:",
    "lisa": "urn:lisa:copilot:ontology:",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "prov": "http://www.w3.org/ns/prov#",
    "label": "rdfs:label",
    "description": "rdfs:comment",
    "subClassOf": {"@id": "rdfs:subClassOf", "@type": "@id"},
    "domain": {"@id": "rdfs:domain", "@type": "@id"},
    "range": {"@id": "rdfs:range", "@type": "@id"},
    "source": {"@id": "prov:wasDerivedFrom", "@type": "@id", "@container": "@set"},
    "contains": {"@id": "lisa:contains", "@type": "@id"},
    "hostedBy": {"@id": "lisa:hostedBy", "@type": "@id"},
    "supportsEngine": {"@id": "lisa:supportsEngine", "@type": "@id"},
    "performsStage": {"@id": "lisa:performsStage", "@type": "@id"},
    "stageOrder": {"@id": "lisa:stageOrder", "@type": "@id", "@container": "@list"},
    "artifactContract": {"@id": "lisa:artifactContract", "@type": "@id"},
    "consumes": {"@id": "lisa:consumes", "@type": "@id"},
    "produces": {"@id": "lisa:produces", "@type": "@id"},
    "completionMarker": {"@id": "lisa:completionMarker", "@type": "@id"},
    "uses": {"@id": "lisa:uses", "@type": "@id"},
    "implementedBy": {"@id": "lisa:implementedBy", "@type": "@id"},
    "validatedBy": {"@id": "lisa:validatedBy", "@type": "@id"},
    "conformsTo": {"@id": "lisa:conformsTo", "@type": "@id"},
    "describesClass": {"@id": "lisa:describesClass", "@type": "@id"},
    "requiresGate": {"@id": "lisa:requiresGate", "@type": "@id"},
    "supportsTarget": {"@id": "lisa:supportsTarget", "@type": "@id"},
    "hasHarness": {"@id": "lisa:hasHarness", "@type": "@id"},
    "retestsWith": {"@id": "lisa:retestsWith", "@type": "@id"},
    "testedBy": {"@id": "lisa:testedBy", "@type": "@id"},
    "fromStage": {"@id": "lisa:fromStage", "@type": "@id"},
    "to": {"@id": "lisa:to", "@type": "@id"},
    "enforcement": {"@id": "lisa:enforcement", "@type": "@id"},
    "affects": {"@id": "lisa:affects", "@type": "@id"},
    "hasStatusVocabulary": {"@id": "lisa:hasStatusVocabulary", "@type": "@id"},
    "hasFinding": {"@id": "lisa:hasFinding", "@type": "@id"},
    "hasEvidence": {"@id": "lisa:hasEvidence", "@type": "@id"},
    "citesSource": {"@id": "lisa:citesSource", "@type": "@id"},
    "addressesFinding": {"@id": "lisa:addressesFinding", "@type": "@id"},
    "hasComponent": {"@id": "lisa:hasComponent", "@type": "@id"},
    "connectsComponent": {"@id": "lisa:connectsComponent", "@type": "@id"},
    "reconcilesComponent": {"@id": "lisa:reconcilesComponent", "@type": "@id"},
    "hasTestCase": {"@id": "lisa:hasTestCase", "@type": "@id"},
    "observationOf": {"@id": "lisa:observationOf", "@type": "@id"},
    "hasRound": {"@id": "lisa:hasRound", "@type": "@id"},
    "recordsOperation": {"@id": "lisa:recordsOperation", "@type": "@id"},
    "verifiedByReceipt": {"@id": "lisa:verifiedByReceipt", "@type": "@id"}
  },
  "@graph": [
    {
      "@id": "lisa:ontology", "@type": "owl:Ontology",
      "label": "LISA Copilot architecture and domain ontology",
      "description": "Source-backed RDFS model of the Copilot CLI and Agency distribution and directly related repository infrastructure. Architecture individuals describe definitions and artifact specifications, not actual customer runs. Other distributions are excluded. This is not an executable state machine or a claim of live cloud verification.",
      "reviewedRevision": "947a64b313799b20da7190d623ebb724d170237b",
      "reviewedOn": "2026-11-10",
      "source": ["lisa:src-plugin", "lisa:src-orchestrator", "lisa:src-stage-registry"]
    },

    {"@id": "lisa:Entity", "@type": "rdfs:Class", "label": "Modeled entity", "description": "An architectural or runtime-domain concept in this ontology."},
    {"@id": "lisa:Distribution", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Plugin distribution", "description": "A deployable host-facing bundle of skills, manifests, integrations and helpers."},
    {"@id": "lisa:ExecutionHost", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Execution host", "description": "The application running LISA, not the platform of the resulting customer agent."},
    {"@id": "lisa:HostEngine", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Host engine", "description": "An engine selected by an execution host; distinct from a Copilot Studio harness."},
    {"@id": "lisa:Skill", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Skill definition", "description": "A host-consumed SKILL.md recipe with associated resources and optional executable helpers."},
    {"@id": "lisa:WorkflowDefinition", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Workflow definition", "description": "An instructed route with conditional gates, not itself an execution record."},
    {"@id": "lisa:StageDefinition", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "CAD stage definition", "description": "One of the nine checkpoint-recognized CAD stages."},
    {"@id": "lisa:WorkflowRun", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Workflow run", "description": "A WF-identified execution with configuration hash, status and completed-stage records.", "source": ["lisa:src-workflow-schema"]},
    {"@id": "lisa:StageRun", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Stage run", "description": "One invocation of a stage, identified separately from the workflow and prior revisions.", "source": ["lisa:src-checkpoint-operations"]},
    {"@id": "lisa:Checkpoint", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Stage checkpoint", "description": "Durable phase/unit cursor, pending operation and latest receipt under the project .lisa directory.", "source": ["lisa:src-checkpoint-operations"]},
    {"@id": "lisa:CompletedStageRecord", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Completed-stage record", "description": "Stage run ID, COMMITTED or BLOCKED status, marker path, marker SHA-256 and completion time.", "source": ["lisa:src-workflow-schema"]},
    {"@id": "lisa:ArtifactSpec", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Artifact specification", "description": "A named input/output family and path pattern, not an actual customer file. A completion marker is a role assigned to such a specification."},
    {"@id": "lisa:Artifact", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Runtime artifact", "description": "Actual persisted input, output or evidence in a project run."},
    {"@id": "lisa:Manifest", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Manifest", "description": "Structured provenance, status or inventory of a stage's artifacts; concrete schemas differ."},
    {"@id": "lisa:ArtifactContract", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Artifact contract", "description": "Per-skill declaration of category, root, inputs, files, schemas, statuses and naming rules.", "source": ["lisa:src-contract-schema"]},
    {"@id": "lisa:JsonSchema", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "JSON Schema", "description": "A structural data constraint, distinct from semantic validation and execution policy."},
    {"@id": "lisa:RuntimeModule", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Runtime module", "description": "Packaged Python, PowerShell or JavaScript implementation, or a cohesive local toolchain."},
    {"@id": "lisa:ExternalSystem", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "External system", "description": "An external service or architecture option; presence in this graph does not establish access or availability."},
    {"@id": "lisa:DeliveryPlatform", "@type": "rdfs:Class", "subClassOf": "lisa:ExternalSystem", "label": "Delivery platform", "description": "A platform with a documented LISA build/configuration path, not necessarily a complete CAD route."},
    {"@id": "lisa:Harness", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Copilot Studio harness", "description": "Standard, GitHub Copilot, or Copilot chat runtime; Cowork has no harness.", "source": ["lisa:src-builder-skill"]},
    {"@id": "lisa:McpServer", "@type": "rdfs:Class", "subClassOf": "lisa:ExternalSystem", "label": "Configured MCP server", "description": "An integration declared in plugin metadata; authentication and actual use are separate."},
    {"@id": "lisa:Prerequisite", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Prerequisite", "description": "A local runtime, tool or optional dependency group needed for a capability."},
    {"@id": "lisa:TestSuite", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Repository test suite", "description": "Local automated checks, not a live-cloud deployment certification."},
    {"@id": "lisa:Gate", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Gate", "description": "A decision or validation boundary, qualified by its actual enforcement mechanism."},
    {"@id": "lisa:EnforcementLevel", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Enforcement level", "description": "Whether described behavior is performed by code, constrained by schema, or directed to the host."},
    {"@id": "lisa:SourceReference", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Repository source reference", "description": "Repository-relative path and 1-based line location at the reviewed revision; an omitted end line means through end of file."},
    {"@id": "lisa:ReviewFinding", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Review finding", "description": "An evidence-backed limitation or discrepancy, not an implemented remediation."},
    {"@id": "lisa:StatusVocabulary", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Status vocabulary", "description": "A context-specific set of case-sensitive values; not interchangeable with another status set."},
    {"@id": "lisa:Transition", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Conditional route", "description": "An instructed routing exception or branch. Conditions are descriptive text, not executable logic."},
    {"@id": "lisa:Outcome", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Workflow outcome", "description": "A terminal handoff or stop outcome."},
    {"@id": "lisa:ProjectConfig", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Project configuration", "description": "lisa-config.json with basePath and customer, knowledge, target-environment and registry configuration.", "source": ["lisa:src-config"]},
    {"@id": "lisa:EvidenceSource", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Evidence source", "description": "Requirement/evaluation material or explicit configuration/corpus evidence; not automatically fetched remote content.", "source": ["lisa:src-analysis-skill", "lisa:src-evaluator-skill"]},
    {"@id": "lisa:ExtractionRecord", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Extraction record", "description": "A source-owned extracted unit with locator, hash and container provenance.", "source": ["lisa:src-analysis-skill"]},
    {"@id": "lisa:ReviewBatch", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Bounded review batch", "description": "Lossless UTF-8 evidence fragments bounded by serialized byte size, not estimated tokens.", "source": ["lisa:src-review-batches"]},
    {"@id": "lisa:ReviewReceipt", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Review receipt", "description": "A hash-bound declaration that a batch was reviewed, not proof of semantic understanding.", "source": ["lisa:src-analysis-skill"]},
    {"@id": "lisa:EvidenceLedger", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Evidence ledger", "description": "Structured findings, citations, record dispositions, review receipts and source-grounded summaries.", "source": ["lisa:src-ledger-schema"]},
    {"@id": "lisa:EvidenceFinding", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Atomic evidence finding", "description": "A stable-ID requirement, fact, context, decision, derived classification, gap or conflict with status, confidence and evidence.", "source": ["lisa:src-finding-schema"]},
    {"@id": "lisa:EvidenceCitation", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Evidence citation", "description": "Source ID, locator and explicit, metadata, derived, configuration or absence-check evidence type.", "source": ["lisa:src-finding-schema"]},
    {"@id": "lisa:ResearchRecord", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Consulted research record", "description": "Recorded product/capability research separate from requirement-file evidence.", "source": ["lisa:src-classifier-skill", "lisa:src-classification-schema"]},
    {"@id": "lisa:RequirementAssessment", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Requirement assessment", "description": "Researched assessment covering an in-scope finding exactly once at classification publication.", "source": ["lisa:src-classifier-scoring"]},
    {"@id": "lisa:CapabilityAssessment", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Capability assessment", "description": "Atomic delivery capability with business weight, implementation disposition and native/demonstration factors.", "source": ["lisa:src-classification-schema", "lisa:src-coverage"]},
    {"@id": "lisa:ClassificationResult", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Classification result", "description": "Suitability, selected platform/harness, complexity, coverage, component inventory and topology.", "source": ["lisa:src-classification-output"]},
    {"@id": "lisa:SolutionTopology", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Complete solution topology", "description": "Grounded components, relationships, boundaries, environments and sequences, including unbuildable dependencies.", "source": ["lisa:src-classification-schema", "lisa:src-classifier-skill"]},
    {"@id": "lisa:TopologyComponent", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Topology component", "description": "A classified solution element with product, responsibility and implementation boundary."},
    {"@id": "lisa:TopologyRelationship", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Topology relationship", "description": "A classified interaction between solution components, not an arbitrary diagram edge."},
    {"@id": "lisa:DesignModel", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Canonical design model", "description": "Classification-derived model authoritative for Business, Engineering and Sequence representations.", "source": ["lisa:src-designer-skill"]},
    {"@id": "lisa:BuildHandoff", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Build handoff", "description": "Agent/target identity, construction evidence, actual dispositions, coverage and evaluator inputs.", "source": ["lisa:src-build-schema"]},
    {"@id": "lisa:BuildDisposition", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Actual build disposition", "description": "Built, configured, simulated, manual, deferred, blocked, failed or not-applicable status for a planned component.", "source": ["lisa:src-build-schema"]},
    {"@id": "lisa:AgentIdentity", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Agent identity", "description": "Actual agent, platform/harness and environment identifiers recorded in build/evaluation artifacts.", "source": ["lisa:src-build-schema", "lisa:src-observations-schema"]},
    {"@id": "lisa:DeployablePackage", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Deployable agent package", "description": "A build-handoff-selected package; publication requires one unambiguous deployable ZIP.", "source": ["lisa:src-publisher-package"]},
    {"@id": "lisa:EvaluationDataset", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Evaluation dataset", "description": "Source-grounded test cases and their source references.", "source": ["lisa:src-evaluator-skill"]},
    {"@id": "lisa:EvaluationRubric", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Evaluation rubric", "description": "Per-gate thresholds and overall pass criteria, not mutable optimization targets.", "source": ["lisa:src-evaluation-renderer", "lisa:src-optimizer-skill"]},
    {"@id": "lisa:EvaluationObservations", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Evaluation observations", "description": "Target-bound test results, browser evidence, aggregates and optimizer handoff.", "source": ["lisa:src-observations-schema"]},
    {"@id": "lisa:TestCase", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Evaluation test case", "description": "Source-grounded prompt, expected behavior, assertions, required tools and pass/fail criteria.", "source": ["lisa:src-evaluation-renderer"]},
    {"@id": "lisa:TestObservation", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Observed test result", "description": "One test's actual response, status, attempt/surface metadata, evidence and gate judgments.", "source": ["lisa:src-observations-schema"]},
    {"@id": "lisa:OptimizationPlan", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Optimization plan", "description": "Target-bound source evaluation, policy, ordered rounds and deferred findings.", "source": ["lisa:src-optimizer-skill"]},
    {"@id": "lisa:OptimizationRound", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Optimization round", "description": "A contiguous round with changes, retest decision and required before/after/rollback snapshots.", "source": ["lisa:src-lifecycle-validation"]},
    {"@id": "lisa:Candidate", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "GEPA instruction candidate", "description": "A hash-identified instruction variant evaluated through host requests, not yet a promoted target version.", "source": ["lisa:src-gepa-bridge", "lisa:src-gepa-outcome"]},
    {"@id": "lisa:RemoteOperationIntent", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Remote operation intent", "description": "Persisted intent before a remote write, carrying identity/idempotency data supplied by the host.", "source": ["lisa:src-builder-skill", "lisa:src-checkpoint-operations"]},
    {"@id": "lisa:RemoteReceipt", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Remote operation receipt", "description": "Host-supplied verified outcome that clears the checkpoint's pending operation.", "source": ["lisa:src-checkpoint-operations"]},
    {"@id": "lisa:PublicationManifest", "@type": "rdfs:Class", "subClassOf": "lisa:Manifest", "label": "Publication manifest", "description": "Dynamically categorized upload selection, expected counts, destinations and metadata.", "source": ["lisa:src-publisher-skill"]},
    {"@id": "lisa:PublicationRecord", "@type": "rdfs:Class", "subClassOf": "lisa:Artifact", "label": "Publication record", "description": "Publication history and terminal evidence; never a substitute for fresh remote inspection.", "source": ["lisa:src-publisher-skill"]},
    {"@id": "lisa:ConsentInventory", "@type": "rdfs:Class", "subClassOf": "lisa:Entity", "label": "Cleanup consent inventory", "description": "Resolved root, paths, sizes and mtimes bound to a fingerprint; not per-file content hashing.", "source": ["lisa:src-cleanup-engine"]},

    {"@id": "lisa:contains", "@type": "rdf:Property", "label": "contains", "domain": "lisa:Entity", "range": "lisa:Entity"},
    {"@id": "lisa:hostedBy", "@type": "rdf:Property", "label": "is hosted by", "domain": "lisa:Distribution", "range": "lisa:ExecutionHost"},
    {"@id": "lisa:supportsEngine", "@type": "rdf:Property", "label": "supports host engine", "domain": "lisa:ExecutionHost", "range": "lisa:HostEngine"},
    {"@id": "lisa:performsStage", "@type": "rdf:Property", "label": "owns stage execution", "domain": "lisa:Skill", "range": "lisa:StageDefinition"},
    {"@id": "lisa:stageOrder", "@type": "rdf:Property", "label": "default ordered stages", "domain": "lisa:WorkflowDefinition", "range": "rdf:List", "description": "An RDF list of StageDefinition identifiers; conditional exits and retests are modeled separately."},
    {"@id": "lisa:artifactContract", "@type": "rdf:Property", "label": "declares artifact contract", "domain": "lisa:Skill", "range": "lisa:ArtifactContract"},
    {"@id": "lisa:consumes", "@type": "rdf:Property", "label": "consumes artifact family", "domain": "lisa:Skill", "range": "lisa:ArtifactSpec"},
    {"@id": "lisa:produces", "@type": "rdf:Property", "label": "produces artifact family", "domain": "lisa:Skill", "range": "lisa:ArtifactSpec"},
    {"@id": "lisa:completionMarker", "@type": "rdf:Property", "label": "commits using marker", "domain": "lisa:StageDefinition", "range": "lisa:ArtifactSpec"},
    {"@id": "lisa:uses", "@type": "rdf:Property", "label": "uses", "domain": "lisa:Entity", "range": "lisa:Entity"},
    {"@id": "lisa:implementedBy", "@type": "rdf:Property", "label": "has packaged implementation", "domain": "lisa:Entity", "range": "lisa:RuntimeModule"},
    {"@id": "lisa:validatedBy", "@type": "rdf:Property", "label": "is checked by", "domain": "lisa:Entity", "range": "lisa:RuntimeModule"},
    {"@id": "lisa:conformsTo", "@type": "rdf:Property", "label": "has schema", "domain": "lisa:Entity", "range": "lisa:JsonSchema"},
    {"@id": "lisa:describesClass", "@type": "rdf:Property", "label": "describes runtime data class", "domain": "lisa:ArtifactSpec", "range": "rdfs:Class"},
    {"@id": "lisa:requiresGate", "@type": "rdf:Property", "label": "requires gate", "domain": "lisa:Entity", "range": "lisa:Gate"},
    {"@id": "lisa:supportsTarget", "@type": "rdf:Property", "label": "supports delivery target", "domain": "lisa:Skill", "range": "lisa:DeliveryPlatform"},
    {"@id": "lisa:hasHarness", "@type": "rdf:Property", "label": "offers harness", "domain": "lisa:DeliveryPlatform", "range": "lisa:Harness"},
    {"@id": "lisa:retestsWith", "@type": "rdf:Property", "label": "delegates behavioral retesting to", "domain": "lisa:Skill", "range": "lisa:Skill"},
    {"@id": "lisa:testedBy", "@type": "rdf:Property", "label": "has local test coverage", "domain": "lisa:Entity", "range": "lisa:TestSuite"},
    {"@id": "lisa:fromStage", "@type": "rdf:Property", "label": "route starts at", "domain": "lisa:Transition", "range": "lisa:StageDefinition"},
    {"@id": "lisa:to", "@type": "rdf:Property", "label": "route leads to", "domain": "lisa:Transition", "range": "lisa:Entity"},
    {"@id": "lisa:enforcement", "@type": "rdf:Property", "label": "enforcement mechanism", "domain": "lisa:Entity", "range": "lisa:EnforcementLevel"},
    {"@id": "lisa:affects", "@type": "rdf:Property", "label": "qualifies modeled behavior of", "domain": "lisa:ReviewFinding", "range": "lisa:Entity"},
    {"@id": "lisa:hasStatusVocabulary", "@type": "rdf:Property", "label": "uses status vocabulary", "domain": "lisa:Entity", "range": "lisa:StatusVocabulary"},
    {"@id": "lisa:hasFinding", "@type": "rdf:Property", "label": "contains finding", "domain": "lisa:EvidenceLedger", "range": "lisa:EvidenceFinding"},
    {"@id": "lisa:hasEvidence", "@type": "rdf:Property", "label": "has supporting citation", "domain": "lisa:EvidenceFinding", "range": "lisa:EvidenceCitation"},
    {"@id": "lisa:citesSource", "@type": "rdf:Property", "label": "cites source", "domain": "lisa:EvidenceCitation", "range": "lisa:EvidenceSource"},
    {"@id": "lisa:addressesFinding", "@type": "rdf:Property", "label": "addresses finding", "domain": "lisa:CapabilityAssessment", "range": "lisa:EvidenceFinding"},
    {"@id": "lisa:hasComponent", "@type": "rdf:Property", "label": "contains topology component", "domain": "lisa:SolutionTopology", "range": "lisa:TopologyComponent"},
    {"@id": "lisa:connectsComponent", "@type": "rdf:Property", "label": "connects component", "domain": "lisa:TopologyRelationship", "range": "lisa:TopologyComponent"},
    {"@id": "lisa:reconcilesComponent", "@type": "rdf:Property", "label": "records actual disposition of", "domain": "lisa:BuildDisposition", "range": "lisa:TopologyComponent"},
    {"@id": "lisa:hasTestCase", "@type": "rdf:Property", "label": "contains test case", "domain": "lisa:EvaluationDataset", "range": "lisa:TestCase"},
    {"@id": "lisa:observationOf", "@type": "rdf:Property", "label": "observes test case", "domain": "lisa:TestObservation", "range": "lisa:TestCase"},
    {"@id": "lisa:hasRound", "@type": "rdf:Property", "label": "contains optimization round", "domain": "lisa:OptimizationPlan", "range": "lisa:OptimizationRound"},
    {"@id": "lisa:recordsOperation", "@type": "rdf:Property", "label": "records pending operation", "domain": "lisa:Checkpoint", "range": "lisa:RemoteOperationIntent"},
    {"@id": "lisa:verifiedByReceipt", "@type": "rdf:Property", "label": "has verified receipt", "domain": "lisa:RemoteOperationIntent", "range": "lisa:RemoteReceipt"},
    {"@id": "lisa:reviewedRevision", "@type": "rdf:Property", "label": "reviewed Git revision", "range": "xsd:string"},
    {"@id": "lisa:reviewedOn", "@type": "rdf:Property", "label": "review date", "range": "xsd:string"},
    {"@id": "lisa:sourcePath", "@type": "rdf:Property", "label": "repository-relative source path", "range": "xsd:string"},
    {"@id": "lisa:lineStart", "@type": "rdf:Property", "label": "first source line", "range": "xsd:integer"},
    {"@id": "lisa:lineEnd", "@type": "rdf:Property", "label": "last source line", "range": "xsd:integer"},
    {"@id": "lisa:anchor", "@type": "rdf:Property", "label": "source anchor text", "range": "xsd:string"},
    {"@id": "lisa:codeValue", "@type": "rdf:Property", "label": "exact code identifier", "range": "xsd:string"},
    {"@id": "lisa:pathPattern", "@type": "rdf:Property", "label": "logical project-relative path pattern", "range": "xsd:string"},
    {"@id": "lisa:category", "@type": "rdf:Property", "label": "artifact contract category", "range": "xsd:string"},
    {"@id": "lisa:rootFolder", "@type": "rdf:Property", "label": "contract output root folder", "range": "xsd:string"},
    {"@id": "lisa:manifestName", "@type": "rdf:Property", "label": "contract-declared manifest name", "range": "xsd:string"},
    {"@id": "lisa:allowedStatus", "@type": "rdf:Property", "label": "case-sensitive allowed status", "range": "xsd:string"},
    {"@id": "lisa:producesArtifacts", "@type": "rdf:Property", "label": "contract produces artifacts", "range": "xsd:boolean"},
    {"@id": "lisa:optional", "@type": "rdf:Property", "label": "optional capability or stage", "range": "xsd:boolean"},
    {"@id": "lisa:condition", "@type": "rdf:Property", "label": "descriptive route condition", "range": "xsd:string"},
    {"@id": "lisa:versionConstraint", "@type": "rdf:Property", "label": "documented runtime version constraint", "range": "xsd:string"},
    {"@id": "lisa:verification", "@type": "rdf:Property", "label": "review verification method and result", "range": "xsd:string"},

    {"@id": "lisa:code", "@type": "lisa:EnforcementLevel", "label": "Packaged code", "description": "Code implements the specific described operation/check; this is not a blanket claim about every skill instruction."},
    {"@id": "lisa:schema", "@type": "lisa:EnforcementLevel", "label": "Schema constraint", "description": "A packaged schema constrains data shape or allowed values."},
    {"@id": "lisa:agent-directed", "@type": "lisa:EnforcementLevel", "label": "Host-directed behavior", "description": "The skill instructs the hosting agent to perform the action, judgment or consent interaction."},
    {"@id": "lisa:workflow-statuses", "@type": "lisa:StatusVocabulary", "label": "Workflow status values", "allowedStatus": ["RUNNING", "WAITING", "RECONCILING", "COMPLETED", "BLOCKED", "FAILED", "CANCELLED"], "source": ["lisa:src-workflow-schema"]},
    {"@id": "lisa:stage-completion-statuses", "@type": "lisa:StatusVocabulary", "label": "Recorded stage completion values", "allowedStatus": ["COMMITTED", "BLOCKED"], "source": ["lisa:src-workflow-schema"]},
    {"@id": "lisa:evaluation-decisions", "@type": "lisa:StatusVocabulary", "label": "Evaluation decisions", "allowedStatus": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"], "source": ["lisa:src-observations-schema"]},

    {"@id": "lisa:distribution", "@type": "lisa:Distribution", "label": "LISA Copilot plugin", "hostedBy": ["lisa:host-copilot-cli", "lisa:host-agency"], "contains": ["lisa:skill-cad-orchestrator", "lisa:skill-requirement-analyzer", "lisa:skill-complexity-classifier", "lisa:skill-solution-designer", "lisa:skill-agent-builder", "lisa:skill-agent-evaluator", "lisa:skill-agent-optimizer", "lisa:skill-artifact-generator", "lisa:skill-artifact-publisher", "lisa:skill-postpublish-cleanup", "lisa:skill-video-generator"], "uses": ["lisa:mcp-playwright", "lisa:mcp-azure", "lisa:mcp-learn", "lisa:mcp-icm", "lisa:mcp-enghub"], "testedBy": ["lisa:tests-plugin"], "source": ["lisa:src-plugin", "lisa:src-agency", "lisa:src-mcp"]},
    {"@id": "lisa:host-copilot-cli", "@type": "lisa:ExecutionHost", "label": "GitHub Copilot CLI", "source": ["lisa:src-install-registration"]},
    {"@id": "lisa:host-agency", "@type": "lisa:ExecutionHost", "label": "Microsoft Agency", "supportsEngine": ["lisa:engine-copilot", "lisa:engine-claude"], "source": ["lisa:src-agency"]},
    {"@id": "lisa:engine-copilot", "@type": "lisa:HostEngine", "label": "Agency Copilot engine", "codeValue": "copilot", "source": ["lisa:src-agency"]},
    {"@id": "lisa:engine-claude", "@type": "lisa:HostEngine", "label": "Agency Claude engine", "codeValue": "claude", "source": ["lisa:src-agency", "lisa:src-claude-manifest"]},
    {"@id": "lisa:cad-workflow", "@type": "lisa:WorkflowDefinition", "label": "Copilot Agent Delivery route", "stageOrder": ["lisa:stage-analysis", "lisa:stage-classification", "lisa:stage-design", "lisa:stage-build", "lisa:stage-evaluation", "lisa:stage-optimization", "lisa:stage-artifacts", "lisa:stage-publication", "lisa:stage-cleanup"], "enforcement": "lisa:agent-directed", "hasStatusVocabulary": ["lisa:workflow-statuses", "lisa:stage-completion-statuses"], "uses": ["lisa:runtime-checkpoints", "lisa:input-config"], "source": ["lisa:src-orchestrator", "lisa:src-stage-registry"]},

    {"@id": "lisa:stage-analysis", "@type": "lisa:StageDefinition", "label": "Analysis", "codeValue": "analysis", "completionMarker": "lisa:artifact-analysis-manifest", "source": ["lisa:src-orchestrator"]},
    {"@id": "lisa:stage-classification", "@type": "lisa:StageDefinition", "label": "Classification", "codeValue": "classification", "completionMarker": "lisa:artifact-classification-manifest", "requiresGate": "lisa:gate-classification-review", "source": ["lisa:src-orchestrator", "lisa:src-human-reviews"]},
    {"@id": "lisa:stage-design", "@type": "lisa:StageDefinition", "label": "Design", "codeValue": "design", "completionMarker": "lisa:artifact-current-design", "requiresGate": "lisa:gate-design-inspection", "source": ["lisa:src-orchestrator", "lisa:src-design-finalization"]},
    {"@id": "lisa:stage-build", "@type": "lisa:StageDefinition", "label": "Build", "codeValue": "build", "completionMarker": "lisa:artifact-build-manifest", "requiresGate": ["lisa:gate-build-review", "lisa:gate-remote-identity"], "source": ["lisa:src-orchestrator", "lisa:src-human-reviews"]},
    {"@id": "lisa:stage-evaluation", "@type": "lisa:StageDefinition", "label": "Evaluation", "codeValue": "evaluation", "completionMarker": "lisa:artifact-evaluation-manifest", "requiresGate": "lisa:gate-deployment", "source": ["lisa:src-orchestrator", "lisa:src-evaluator-skill"]},
    {"@id": "lisa:stage-optimization", "@type": "lisa:StageDefinition", "label": "Optimization", "codeValue": "optimization", "completionMarker": "lisa:artifact-optimization-manifest", "requiresGate": "lisa:gate-remote-identity", "source": ["lisa:src-orchestrator", "lisa:src-optimizer-skill"]},
    {"@id": "lisa:stage-artifacts", "@type": "lisa:StageDefinition", "label": "Artifact generation", "codeValue": "artifacts", "completionMarker": "lisa:artifact-generation-manifest", "source": ["lisa:src-orchestrator"]},
    {"@id": "lisa:stage-publication", "@type": "lisa:StageDefinition", "label": "Publication", "codeValue": "publication", "completionMarker": "lisa:artifact-publication-record", "requiresGate": "lisa:gate-publication-proof", "source": ["lisa:src-orchestrator", "lisa:src-publisher-skill"]},
    {"@id": "lisa:stage-cleanup", "@type": "lisa:StageDefinition", "label": "Optional cleanup", "codeValue": "cleanup", "optional": true, "completionMarker": "lisa:artifact-cleanup-checkpoint", "requiresGate": ["lisa:gate-publication-proof", "lisa:gate-cleanup-consent"], "source": ["lisa:src-orchestrator-cleanup", "lisa:src-cleanup-skill"]},
    {"@id": "lisa:route-deterministic", "@type": "lisa:Transition", "label": "Accepted deterministic handoff", "fromStage": "lisa:stage-classification", "to": "lisa:outcome-deterministic", "condition": "Human accepts classification with agentic_platform equal to Deterministic (no agent); finish without design or agent stages.", "enforcement": "lisa:agent-directed", "source": ["lisa:src-human-reviews"]},
    {"@id": "lisa:route-classification-revision", "@type": "lisa:Transition", "label": "Classification revision", "fromStage": "lisa:stage-classification", "to": "lisa:stage-classification", "condition": "Human selects Revise; collect feedback, preserve prior evidence and start a new classification run.", "enforcement": "lisa:agent-directed", "source": ["lisa:src-human-reviews"]},
    {"@id": "lisa:route-build-revision", "@type": "lisa:Transition", "label": "Build revision", "fromStage": "lisa:stage-build", "to": "lisa:stage-build", "condition": "Human selects Revise; preserve prior evidence and remote state, then start a new build run.", "enforcement": "lisa:agent-directed", "source": ["lisa:src-human-reviews"]},
    {"@id": "lisa:route-keep-output", "@type": "lisa:Transition", "label": "Finish without cleanup", "fromStage": "lisa:stage-publication", "to": "lisa:outcome-completed", "condition": "Publication verified and human declines deletion; leave all local output untouched.", "enforcement": "lisa:agent-directed", "source": ["lisa:src-orchestrator-cleanup"]},
    {"@id": "lisa:outcome-deterministic", "@type": "lisa:Outcome", "label": "Deterministic solution handoff", "source": ["lisa:src-human-reviews"]},
    {"@id": "lisa:outcome-completed", "@type": "lisa:Outcome", "label": "Completed workflow", "source": ["lisa:src-orchestrator-cleanup"]},

    {"@id": "lisa:skill-cad-orchestrator", "@type": "lisa:Skill", "label": "cad-orchestrator", "codeValue": "cad-orchestrator", "artifactContract": "lisa:contract-cad-orchestrator", "uses": ["lisa:cad-workflow", "lisa:runtime-paths", "lisa:runtime-checkpoints"], "consumes": ["lisa:input-config", "lisa:input-requirements"], "enforcement": "lisa:agent-directed", "description": "Routes skills in the host session. It is neither an executable pipeline nor an additional checkpoint stage.", "source": ["lisa:src-orchestrator"]},
    {"@id": "lisa:skill-requirement-analyzer", "@type": "lisa:Skill", "label": "requirement-analyzer", "codeValue": "requirement-analyzer", "performsStage": "lisa:stage-analysis", "artifactContract": "lisa:contract-requirement-analyzer", "consumes": ["lisa:input-config", "lisa:input-requirements"], "produces": ["lisa:artifact-evidence-ledger", "lisa:artifact-analysis-markdown", "lisa:artifact-analysis-manifest", "lisa:artifact-review-batches"], "implementedBy": "lisa:runtime-analysis", "uses": ["lisa:runtime-paths", "lisa:runtime-review-batches", "lisa:runtime-analysis-handoff", "lisa:runtime-checkpoints"], "enforcement": ["lisa:code", "lisa:schema", "lisa:agent-directed"], "source": ["lisa:src-analysis-skill", "lisa:src-analysis-publish"]},
    {"@id": "lisa:skill-complexity-classifier", "@type": "lisa:Skill", "label": "complexity-classifier", "codeValue": "complexity-classifier", "performsStage": "lisa:stage-classification", "artifactContract": "lisa:contract-complexity-classifier", "consumes": ["lisa:input-config", "lisa:artifact-evidence-ledger", "lisa:artifact-analysis-manifest"], "produces": ["lisa:artifact-classification", "lisa:artifact-classification-manifest"], "implementedBy": "lisa:runtime-classifier", "uses": ["lisa:runtime-analysis-handoff", "lisa:runtime-review-batches", "lisa:runtime-checkpoints", "lisa:mcp-learn", "lisa:mcp-azure", "lisa:mcp-icm", "lisa:mcp-enghub", "lisa:platform-foundry", "lisa:platform-agent-framework"], "enforcement": ["lisa:code", "lisa:schema", "lisa:agent-directed"], "source": ["lisa:src-classifier-skill", "lisa:src-classifier-scoring", "lisa:src-coverage"]},
    {"@id": "lisa:skill-solution-designer", "@type": "lisa:Skill", "label": "solution-designer", "codeValue": "solution-designer", "performsStage": "lisa:stage-design", "artifactContract": "lisa:contract-solution-designer", "consumes": ["lisa:input-config", "lisa:artifact-classification"], "produces": ["lisa:artifact-design-model", "lisa:artifact-current-design", "lisa:artifact-design-diagrams", "lisa:artifact-design-inspection"], "implementedBy": "lisa:runtime-designer", "uses": ["lisa:runtime-input-router", "lisa:runtime-checkpoints", "lisa:prerequisite-renderer", "lisa:mcp-playwright"], "enforcement": ["lisa:code", "lisa:schema", "lisa:agent-directed"], "source": ["lisa:src-designer-skill", "lisa:src-design-finalization"]},
    {"@id": "lisa:skill-agent-builder", "@type": "lisa:Skill", "label": "agent-builder", "codeValue": "agent-builder", "performsStage": "lisa:stage-build", "artifactContract": "lisa:contract-agent-builder", "consumes": ["lisa:input-config", "lisa:artifact-classification", "lisa:artifact-current-design", "lisa:artifact-design-diagrams"], "produces": ["lisa:artifact-build-handoff", "lisa:artifact-build-manifest", "lisa:artifact-live-state", "lisa:artifact-solution-manifest", "lisa:artifact-instructions", "lisa:artifact-deployable-package"], "uses": ["lisa:runtime-input-router", "lisa:runtime-lifecycle-manifests", "lisa:runtime-builder-validation", "lisa:runtime-checkpoints", "lisa:prerequisite-pac", "lisa:mcp-playwright"], "supportsTarget": ["lisa:platform-copilot-studio", "lisa:platform-cowork"], "enforcement": ["lisa:agent-directed", "lisa:schema", "lisa:code"], "description": "Initial construction is host-owned. Package production is conditional on build mode. Imported reconciliation checks have a CLI-wiring limitation recorded by finding R1.", "source": ["lisa:src-builder-skill", "lisa:src-build-schema", "lisa:src-builder-validation"]},
    {"@id": "lisa:skill-agent-evaluator", "@type": "lisa:Skill", "label": "agent-evaluator", "codeValue": "agent-evaluator", "performsStage": "lisa:stage-evaluation", "artifactContract": "lisa:contract-agent-evaluator", "consumes": ["lisa:input-config", "lisa:input-eval-data", "lisa:artifact-classification", "lisa:artifact-build-handoff"], "produces": ["lisa:artifact-evaluation-dataset", "lisa:artifact-evaluation-rubric", "lisa:artifact-evaluation-observations", "lisa:artifact-regression-baseline", "lisa:artifact-deployment-summary", "lisa:artifact-evaluation-manifest"], "implementedBy": "lisa:runtime-evaluation-renderer", "uses": ["lisa:runtime-input-router", "lisa:runtime-lifecycle-manifests", "lisa:runtime-checkpoints", "lisa:mcp-playwright"], "supportsTarget": "lisa:platform-copilot-studio", "hasStatusVocabulary": "lisa:evaluation-decisions", "enforcement": ["lisa:agent-directed", "lisa:schema", "lisa:code"], "description": "Only behavioral evaluation authority. Host executes tests and records observations; code derives reports and aggregates. A valid FAIL is evidence, not an execution error.", "source": ["lisa:src-evaluator-skill", "lisa:src-evaluation-renderer"]},
    {"@id": "lisa:skill-agent-optimizer", "@type": "lisa:Skill", "label": "agent-optimizer", "codeValue": "agent-optimizer", "performsStage": "lisa:stage-optimization", "artifactContract": "lisa:contract-agent-optimizer", "consumes": ["lisa:input-config", "lisa:artifact-evaluation-manifest", "lisa:artifact-evaluation-dataset", "lisa:artifact-evaluation-rubric", "lisa:artifact-evaluation-observations", "lisa:artifact-regression-baseline", "lisa:artifact-build-handoff"], "produces": ["lisa:artifact-instruction-audit", "lisa:artifact-optimization-plan", "lisa:artifact-optimization-rounds", "lisa:artifact-optimization-manifest", "lisa:artifact-gepa-run", "lisa:artifact-optimization-outcome"], "retestsWith": "lisa:skill-agent-evaluator", "uses": ["lisa:runtime-input-router", "lisa:runtime-lifecycle-manifests", "lisa:runtime-gepa", "lisa:runtime-checkpoints", "lisa:prerequisite-gepa", "lisa:mcp-playwright", "lisa:prerequisite-pac"], "supportsTarget": "lisa:platform-copilot-studio", "enforcement": ["lisa:agent-directed", "lisa:schema", "lisa:code"], "description": "Owns post-evaluation changes and rollback, not behavioral scoring. GEPA output is conditional on eligibility; candidate requests stay within optimization.", "source": ["lisa:src-optimizer-skill", "lisa:src-gepa-bridge", "lisa:src-gepa-outcome"]},
    {"@id": "lisa:skill-artifact-generator", "@type": "lisa:Skill", "label": "artifact-generator", "codeValue": "artifact-generator", "performsStage": "lisa:stage-artifacts", "artifactContract": "lisa:contract-artifact-generator", "consumes": ["lisa:input-config", "lisa:artifact-evidence-ledger", "lisa:artifact-classification", "lisa:artifact-current-design", "lisa:artifact-build-handoff", "lisa:artifact-evaluation-observations", "lisa:artifact-optimization-manifest"], "produces": ["lisa:artifact-customer-document", "lisa:artifact-execution-tree", "lisa:artifact-generation-manifest"], "implementedBy": "lisa:runtime-artifact-composer", "uses": ["lisa:runtime-paths", "lisa:runtime-checkpoints"], "enforcement": "lisa:code", "source": ["lisa:src-generator-skill", "lisa:src-artifact-generation"]},
    {"@id": "lisa:skill-artifact-publisher", "@type": "lisa:Skill", "label": "artifact-publisher", "codeValue": "artifact-publisher", "performsStage": "lisa:stage-publication", "artifactContract": "lisa:contract-artifact-publisher", "consumes": ["lisa:input-config", "lisa:artifact-build-handoff", "lisa:artifact-deployable-package", "lisa:artifact-build-manifest", "lisa:artifact-current-design", "lisa:artifact-evaluation-manifest", "lisa:artifact-optimization-manifest", "lisa:artifact-generation-manifest", "lisa:artifact-customer-document", "lisa:artifact-execution-tree"], "produces": ["lisa:artifact-publication-manifest", "lisa:artifact-publication-record", "lisa:artifact-remote-inventory"], "implementedBy": ["lisa:runtime-publication-guard", "lisa:runtime-sharepoint-rest"], "uses": ["lisa:runtime-checkpoints", "lisa:mcp-playwright", "lisa:sharepoint-registry"], "enforcement": ["lisa:code", "lisa:agent-directed"], "source": ["lisa:src-publisher-skill", "lisa:src-publication-verification"]},
    {"@id": "lisa:skill-postpublish-cleanup", "@type": "lisa:Skill", "label": "postpublish-cleanup", "codeValue": "postpublish-cleanup", "performsStage": "lisa:stage-cleanup", "artifactContract": "lisa:contract-postpublish-cleanup", "consumes": ["lisa:input-config", "lisa:input-output-tree"], "implementedBy": "lisa:runtime-cleanup", "uses": "lisa:runtime-checkpoints", "enforcement": ["lisa:code", "lisa:agent-directed"], "description": "Produces no artifacts inside output. The host records cleanup completion in an external checkpoint; the CLI itself does not verify publication or acquire human consent.", "source": ["lisa:src-cleanup-skill", "lisa:src-cleanup-engine", "lisa:src-orchestrator-cleanup"]},
    {"@id": "lisa:skill-video-generator", "@type": "lisa:Skill", "label": "video-generator", "codeValue": "video-generator", "artifactContract": "lisa:contract-video-generator", "optional": true, "consumes": ["lisa:artifact-build-handoff", "lisa:artifact-current-design", "lisa:artifact-evaluation-observations"], "produces": "lisa:artifact-video-production", "implementedBy": "lisa:runtime-video", "uses": "lisa:prerequisite-video", "enforcement": ["lisa:code", "lisa:agent-directed"], "description": "Explicit standalone invocation only. Existing LISA artifacts are optional grounding, not authorization to run cloud stages. There is no CAD stage, checkpoint marker or automatic publication.", "source": ["lisa:src-video-skill", "lisa:src-video-initializer"]},

    {"@id": "lisa:contract-cad-orchestrator", "@type": "lisa:ArtifactContract", "label": "Orchestrator artifact contract", "codeValue": "cad-orchestrator", "category": "orchestration", "producesArtifacts": false, "allowedStatus": ["running", "paused", "completed", "failed"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-orchestrator"]},
    {"@id": "lisa:contract-requirement-analyzer", "@type": "lisa:ArtifactContract", "label": "Analysis artifact contract", "codeValue": "requirement-analyzer", "category": "analysis", "rootFolder": "analysis", "producesArtifacts": true, "manifestName": "requirement-analysis_<timestamp>-manifest.json", "allowedStatus": ["prepared", "rendered_pending_validation", "validated"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-analysis"]},
    {"@id": "lisa:contract-complexity-classifier", "@type": "lisa:ArtifactContract", "label": "Classification artifact contract", "codeValue": "complexity-classifier", "category": "classification", "rootFolder": "classification", "producesArtifacts": true, "manifestName": "classification-manifest.json", "allowedStatus": ["prepared", "research-expanded", "validated"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-classification"]},
    {"@id": "lisa:contract-solution-designer", "@type": "lisa:ArtifactContract", "label": "Design artifact contract", "codeValue": "solution-designer", "category": "design", "rootFolder": "design", "producesArtifacts": true, "manifestName": "current-design.json", "allowedStatus": ["prepared", "awaiting_inspection", "validated"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-design"]},
    {"@id": "lisa:contract-agent-builder", "@type": "lisa:ArtifactContract", "label": "Build artifact contract", "codeValue": "agent-builder", "category": "build", "rootFolder": "build", "producesArtifacts": true, "manifestName": "build-manifest.json", "allowedStatus": ["complete", "blocked"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-build"]},
    {"@id": "lisa:contract-agent-evaluator", "@type": "lisa:ArtifactContract", "label": "Evaluation artifact contract", "codeValue": "agent-evaluator", "category": "evaluation", "rootFolder": "evaluation", "producesArtifacts": true, "manifestName": "evaluation-manifest.json", "allowedStatus": ["pass", "fail", "blocked"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-evaluation"]},
    {"@id": "lisa:contract-agent-optimizer", "@type": "lisa:ArtifactContract", "label": "Optimization artifact contract", "codeValue": "agent-optimizer", "category": "optimization", "rootFolder": "optimization", "producesArtifacts": true, "manifestName": "optimization-manifest.json", "allowedStatus": ["complete", "blocked", "rolled-back"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-optimization"]},
    {"@id": "lisa:contract-artifact-generator", "@type": "lisa:ArtifactContract", "label": "Customer artifact contract", "codeValue": "artifact-generator", "category": "artifacts", "rootFolder": "artifacts", "producesArtifacts": true, "manifestName": "artifact-generation-manifest.json", "allowedStatus": ["passed", "failed"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-artifacts"]},
    {"@id": "lisa:contract-artifact-publisher", "@type": "lisa:ArtifactContract", "label": "Publication artifact contract", "codeValue": "artifact-publisher", "category": "publication", "rootFolder": "publication", "producesArtifacts": true, "manifestName": "publication-manifest.json", "allowedStatus": ["PUBLISHED", "PARTIAL", "FAILED", "SKIPPED"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-publication"]},
    {"@id": "lisa:contract-postpublish-cleanup", "@type": "lisa:ArtifactContract", "label": "Cleanup artifact contract", "codeValue": "postpublish-cleanup", "category": "cleanup", "producesArtifacts": false, "allowedStatus": ["inventory", "passed", "failed"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-cleanup"]},
    {"@id": "lisa:contract-video-generator", "@type": "lisa:ArtifactContract", "label": "Standalone video artifact contract", "codeValue": "video-generator", "category": "video", "rootFolder": "video", "producesArtifacts": true, "allowedStatus": ["passed", "blocked"], "conformsTo": "lisa:schema-artifact-contract", "source": ["lisa:src-contract-video"]},

    {"@id": "lisa:input-config", "@type": "lisa:ArtifactSpec", "label": "Project config", "pathPattern": "lisa-config.json", "describesClass": "lisa:ProjectConfig", "validatedBy": "lisa:runtime-paths", "source": ["lisa:src-config", "lisa:src-paths"]},
    {"@id": "lisa:input-requirements", "@type": "lisa:ArtifactSpec", "label": "Requirement source corpus", "pathPattern": "requirements/", "describesClass": "lisa:EvidenceSource", "source": ["lisa:src-analysis-skill"]},
    {"@id": "lisa:input-eval-data", "@type": "lisa:ArtifactSpec", "label": "Evaluation source corpus", "pathPattern": "evalData/", "describesClass": "lisa:EvidenceSource", "source": ["lisa:src-evaluator-skill"]},
    {"@id": "lisa:input-output-tree", "@type": "lisa:ArtifactSpec", "label": "Project output tree", "pathPattern": "output/", "source": ["lisa:src-paths", "lisa:src-cleanup-skill"]},
    {"@id": "lisa:artifact-evidence-ledger", "@type": "lisa:ArtifactSpec", "label": "Published evidence ledger", "pathPattern": "output/analysis/requirement-analysis_<timestamp>.json", "describesClass": "lisa:EvidenceLedger", "conformsTo": "lisa:schema-evidence-ledger", "validatedBy": ["lisa:runtime-analysis", "lisa:runtime-analysis-handoff"], "source": ["lisa:src-contract-analysis", "lisa:src-analysis-handoff"]},
    {"@id": "lisa:artifact-analysis-markdown", "@type": "lisa:ArtifactSpec", "label": "Readable requirement analysis", "pathPattern": "output/analysis/requirement-analysis_<timestamp>.md", "source": ["lisa:src-contract-analysis"]},
    {"@id": "lisa:artifact-analysis-manifest", "@type": "lisa:ArtifactSpec", "label": "Validated analysis publication marker", "pathPattern": "output/analysis/requirement-analysis_<timestamp>-manifest.json", "describesClass": "lisa:Manifest", "validatedBy": "lisa:runtime-analysis-handoff", "source": ["lisa:src-analysis-handoff", "lisa:src-contract-analysis"]},
    {"@id": "lisa:artifact-review-batches", "@type": "lisa:ArtifactSpec", "label": "Bounded evidence review batches", "describesClass": "lisa:ReviewBatch", "validatedBy": "lisa:runtime-review-batches", "source": ["lisa:src-review-batches", "lisa:src-analysis-skill"]},
    {"@id": "lisa:artifact-classification", "@type": "lisa:ArtifactSpec", "label": "Classification JSON and readable sibling", "pathPattern": "output/classification/complexity-classification_<timestamp>.json", "describesClass": "lisa:ClassificationResult", "conformsTo": "lisa:schema-classification-output", "validatedBy": "lisa:runtime-classifier", "source": ["lisa:src-contract-classification", "lisa:src-classifier-scoring"]},
    {"@id": "lisa:artifact-classification-manifest", "@type": "lisa:ArtifactSpec", "label": "Classification publication marker", "pathPattern": "output/classification/classification-manifest.json", "describesClass": "lisa:Manifest", "source": ["lisa:src-contract-classification"]},
    {"@id": "lisa:artifact-design-model", "@type": "lisa:ArtifactSpec", "label": "Canonical design model", "describesClass": "lisa:DesignModel", "validatedBy": "lisa:runtime-designer", "source": ["lisa:src-designer-skill", "lisa:src-contract-design"]},
    {"@id": "lisa:artifact-design-diagrams", "@type": "lisa:ArtifactSpec", "label": "Business, Engineering and Sequence diagram set", "description": "BA, SA and SD SVG/PNG plus editable Draw.io/Mermaid and Architecture Review HTML. Resolve actual published paths from current-design.json.", "validatedBy": "lisa:runtime-designer", "source": ["lisa:src-designer-skill", "lisa:src-design-finalization"]},
    {"@id": "lisa:artifact-design-inspection", "@type": "lisa:ArtifactSpec", "label": "Design inspection and browser evidence", "source": ["lisa:src-designer-skill", "lisa:src-design-finalization"]},
    {"@id": "lisa:artifact-current-design", "@type": "lisa:ArtifactSpec", "label": "Current validated design pointer", "pathPattern": "output/design/current-design.json", "describesClass": "lisa:Manifest", "validatedBy": "lisa:runtime-designer", "source": ["lisa:src-design-finalization"]},
    {"@id": "lisa:artifact-build-handoff", "@type": "lisa:ArtifactSpec", "label": "Agent build handoff", "pathPattern": "output/build/agent-build-handoff.json", "describesClass": "lisa:BuildHandoff", "conformsTo": "lisa:schema-build-handoff", "validatedBy": ["lisa:runtime-lifecycle-manifests", "lisa:runtime-builder-validation"], "source": ["lisa:src-build-schema", "lisa:src-builder-validation"]},
    {"@id": "lisa:artifact-build-manifest", "@type": "lisa:ArtifactSpec", "label": "Build manifest", "pathPattern": "output/build/build-manifest.json", "describesClass": "lisa:Manifest", "validatedBy": "lisa:runtime-lifecycle-manifests", "source": ["lisa:src-contract-build", "lisa:src-lifecycle-publication"]},
    {"@id": "lisa:artifact-live-state", "@type": "lisa:ArtifactSpec", "label": "Agent live-state evidence", "pathPattern": "output/build/agent-live-state.json", "source": ["lisa:src-contract-build", "lisa:src-lifecycle-validation"]},
    {"@id": "lisa:artifact-solution-manifest", "@type": "lisa:ArtifactSpec", "label": "Agent solution inventory", "pathPattern": "output/build/agent-solution-manifest.json", "describesClass": "lisa:Manifest", "source": ["lisa:src-contract-build"]},
    {"@id": "lisa:artifact-instructions", "@type": "lisa:ArtifactSpec", "label": "Persisted agent instructions", "pathPattern": "output/build/agent-instructions.md", "source": ["lisa:src-contract-build", "lisa:src-lifecycle-validation"]},
    {"@id": "lisa:artifact-deployable-package", "@type": "lisa:ArtifactSpec", "label": "Deployable package selected by build handoff", "describesClass": "lisa:DeployablePackage", "description": "Conditional on build mode; Cowork configuration and assessment-only handoffs have no package.", "validatedBy": "lisa:runtime-publication-guard", "source": ["lisa:src-build-modes", "lisa:src-publisher-package"]},
    {"@id": "lisa:artifact-evaluation-dataset", "@type": "lisa:ArtifactSpec", "label": "Evaluation dataset", "pathPattern": "output/evaluation/evaluation-dataset.json", "describesClass": "lisa:EvaluationDataset", "source": ["lisa:src-contract-evaluation"]},
    {"@id": "lisa:artifact-evaluation-rubric", "@type": "lisa:ArtifactSpec", "label": "Evaluation rubric", "pathPattern": "output/evaluation/evaluation-rubric.json", "describesClass": "lisa:EvaluationRubric", "source": ["lisa:src-contract-evaluation", "lisa:src-evaluation-renderer"]},
    {"@id": "lisa:artifact-evaluation-observations", "@type": "lisa:ArtifactSpec", "label": "Evaluation observations and optimizer handoff", "pathPattern": "output/evaluation/evaluation-observations.json", "describesClass": "lisa:EvaluationObservations", "conformsTo": "lisa:schema-evaluation-observations", "validatedBy": ["lisa:runtime-evaluation-renderer", "lisa:runtime-lifecycle-manifests"], "source": ["lisa:src-observations-schema"]},
    {"@id": "lisa:artifact-regression-baseline", "@type": "lisa:ArtifactSpec", "label": "Regression baseline", "pathPattern": "output/evaluation/regression-baseline.json", "source": ["lisa:src-contract-evaluation", "lisa:src-evaluation-renderer"]},
    {"@id": "lisa:artifact-deployment-summary", "@type": "lisa:ArtifactSpec", "label": "Deployment gate summary", "pathPattern": "output/evaluation/deployment-gate-summary.md", "source": ["lisa:src-contract-evaluation"]},
    {"@id": "lisa:artifact-evaluation-manifest", "@type": "lisa:ArtifactSpec", "label": "Evaluation manifest", "pathPattern": "output/evaluation/evaluation-manifest.json", "describesClass": "lisa:Manifest", "validatedBy": "lisa:runtime-lifecycle-manifests", "source": ["lisa:src-contract-evaluation", "lisa:src-lifecycle-validation"]},
    {"@id": "lisa:artifact-instruction-audit", "@type": "lisa:ArtifactSpec", "label": "Read-only instruction audit JSON and Markdown", "pathPattern": "output/optimization/instruction-audit.json", "source": ["lisa:src-optimizer-skill", "lisa:src-contract-optimization"]},
    {"@id": "lisa:artifact-optimization-plan", "@type": "lisa:ArtifactSpec", "label": "Optimization plan", "pathPattern": "output/optimization/optimization-plan.json", "describesClass": "lisa:OptimizationPlan", "source": ["lisa:src-contract-optimization"]},
    {"@id": "lisa:artifact-optimization-rounds", "@type": "lisa:ArtifactSpec", "label": "Optimization round reports and snapshots", "pathPattern": "output/optimization/rounds/round-<number>/", "description": "Before/after state and, when rejected, rollback state are required according to round status.", "source": ["lisa:src-lifecycle-validation", "lisa:src-optimizer-skill"]},
    {"@id": "lisa:artifact-optimization-manifest", "@type": "lisa:ArtifactSpec", "label": "Optimization manifest", "pathPattern": "output/optimization/optimization-manifest.json", "describesClass": "lisa:Manifest", "validatedBy": "lisa:runtime-lifecycle-manifests", "source": ["lisa:src-contract-optimization", "lisa:src-lifecycle-publication"]},
    {"@id": "lisa:artifact-gepa-run", "@type": "lisa:ArtifactSpec", "label": "Optional GEPA search result", "pathPattern": "output/optimization/gepa-run.json", "optional": true, "validatedBy": "lisa:runtime-gepa", "source": ["lisa:src-gepa-outcome"]},
    {"@id": "lisa:artifact-optimization-outcome", "@type": "lisa:ArtifactSpec", "label": "Optimization outcome and measured impact", "pathPattern": "output/optimization/optimization-outcome.json", "validatedBy": "lisa:runtime-gepa", "source": ["lisa:src-gepa-outcome"]},
    {"@id": "lisa:artifact-customer-document", "@type": "lisa:ArtifactSpec", "label": "Customer solution document", "pathPattern": "output/artifacts/solution-document.md", "source": ["lisa:src-generator-skill", "lisa:src-artifact-generation"]},
    {"@id": "lisa:artifact-execution-tree", "@type": "lisa:ArtifactSpec", "label": "Self-contained execution tree", "pathPattern": "output/artifacts/lisa-execution-tree.html", "source": ["lisa:src-generator-skill", "lisa:src-artifact-generation"]},
    {"@id": "lisa:artifact-generation-manifest", "@type": "lisa:ArtifactSpec", "label": "Final artifact inventory", "pathPattern": "output/artifacts/artifact-generation-manifest.json", "describesClass": "lisa:Manifest", "validatedBy": "lisa:runtime-artifact-composer", "source": ["lisa:src-contract-artifacts", "lisa:src-artifact-generation"]},
    {"@id": "lisa:artifact-publication-manifest", "@type": "lisa:ArtifactSpec", "label": "Dynamic categorized publication manifest", "pathPattern": "output/publication/publication-manifest.json", "describesClass": "lisa:PublicationManifest", "validatedBy": "lisa:runtime-publication-guard", "source": ["lisa:src-publisher-skill", "lisa:src-contract-publication"]},
    {"@id": "lisa:artifact-publication-record", "@type": "lisa:ArtifactSpec", "label": "Publication history and completion marker", "pathPattern": "output/publication/publication-record.json", "describesClass": "lisa:PublicationRecord", "source": ["lisa:src-publisher-skill"]},
    {"@id": "lisa:artifact-remote-inventory", "@type": "lisa:ArtifactSpec", "label": "Fresh SharePoint remote inventory", "description": "Read-back paths, sizes, available comparable hashes, metadata and execution order supplied to the guard.", "validatedBy": "lisa:runtime-publication-guard", "source": ["lisa:src-publication-verification", "lisa:src-sharepoint-rest"]},
    {"@id": "lisa:artifact-cleanup-checkpoint", "@type": "lisa:ArtifactSpec", "label": "Cleanup's external checkpoint marker", "pathPattern": ".lisa/runs/<workflowRunId>/active-stage.json", "describesClass": "lisa:Checkpoint", "source": ["lisa:src-orchestrator-cleanup", "lisa:src-checkpoint-operations"]},
    {"@id": "lisa:artifact-video-production", "@type": "lisa:ArtifactSpec", "label": "Standalone marketing video production", "pathPattern": "output/video/<solution-slug>/<run-id>/", "description": "For LISA projects: storyboard, assets, watch page, MP4, SRT/VTT captions, thumbnail/storyboard images, timing and verification. Other solutions use an explicit output location.", "source": ["lisa:src-video-skill", "lisa:src-contract-video"]},

    {"@id": "lisa:schema-artifact-contract", "@type": "lisa:JsonSchema", "label": "Common artifact-contract schema", "validatedBy": "lisa:runtime-contract-validator", "source": ["lisa:src-contract-schema"]},
    {"@id": "lisa:schema-workflow-checkpoint", "@type": "lisa:JsonSchema", "label": "Workflow-checkpoint schema", "description": "Declared checkpoint shape. The checkpoint engine uses its own checks rather than invoking a JSON Schema validator on every transition.", "source": ["lisa:src-workflow-schema", "lisa:src-checkpoint-operations"]},
    {"@id": "lisa:schema-evidence-ledger", "@type": "lisa:JsonSchema", "label": "Evidence-ledger schema", "source": ["lisa:src-ledger-schema"]},
    {"@id": "lisa:schema-classification-output", "@type": "lisa:JsonSchema", "label": "Classification-output schema", "source": ["lisa:src-classification-output"]},
    {"@id": "lisa:schema-build-handoff", "@type": "lisa:JsonSchema", "label": "Agent-build-handoff schema", "source": ["lisa:src-build-schema", "lisa:src-build-modes"]},
    {"@id": "lisa:schema-evaluation-observations", "@type": "lisa:JsonSchema", "label": "Evaluation-observations schema", "source": ["lisa:src-observations-schema"]},
    {"@id": "lisa:runtime-paths", "@type": "lisa:RuntimeModule", "label": "Config-relative path resolver", "description": "Resolves basePath relative to the config file, derives canonical project children and rejects escapes in relative child paths.", "source": ["lisa:src-paths"]},
    {"@id": "lisa:runtime-input-router", "@type": "lisa:RuntimeModule", "label": "Stage input router", "description": "Canonical inputs for nine stage skills; no router entry for orchestrator or standalone video.", "uses": ["lisa:runtime-paths", "lisa:runtime-analysis-handoff"], "source": ["lisa:src-input-router"]},
    {"@id": "lisa:runtime-analysis-handoff", "@type": "lisa:RuntimeModule", "label": "Validated analysis handoff", "description": "Binds ledger and Markdown to a validated manifest and source root; never skips an invalid newest ledger in favor of an older run.", "testedBy": "lisa:tests-analysis-handoff", "source": ["lisa:src-analysis-handoff"]},
    {"@id": "lisa:runtime-review-batches", "@type": "lisa:RuntimeModule", "label": "Lossless bounded review batching", "description": "Serializes complete UTF-8 batches within a default 16384-byte budget; splits text at codepoint boundaries with record/part provenance.", "source": ["lisa:src-review-batches"]},
    {"@id": "lisa:runtime-contract-validator", "@type": "lisa:RuntimeModule", "label": "Artifact contract definition validator", "description": "Checks declarations, schema references and naming patterns; does not validate arbitrary runtime output sets.", "source": ["lisa:src-contract-validator"]},
    {"@id": "lisa:runtime-checkpoints", "@type": "lisa:RuntimeModule", "label": "Workflow checkpoint engine", "description": "Atomic snapshots, hashes, phase/unit cursors and pending-operation recovery. Does not enforce predecessor order, human approval or semantic marker validation.", "uses": "lisa:runtime-paths", "testedBy": "lisa:tests-checkpoints", "source": ["lisa:src-checkpoint-storage", "lisa:src-checkpoint-operations", "lisa:src-checkpoint-recovery"]},
    {"@id": "lisa:runtime-lifecycle-manifests", "@type": "lisa:RuntimeModule", "label": "Shared build/evaluation/optimization manifest engine", "description": "Inventories artifacts, checks schemas/hashes/sizes/run provenance and stage semantics, and restores a prior manifest when publication validation fails.", "uses": "lisa:runtime-contract-validator", "source": ["lisa:src-lifecycle-validation", "lisa:src-lifecycle-publication"]},
    {"@id": "lisa:runtime-analysis", "@type": "lisa:RuntimeModule", "label": "Requirement analysis pipeline", "description": "Prepare/extract/cache, normalize, render, validate and publish model-authored evidence ledgers.", "source": ["lisa:src-analysis-skill", "lisa:src-analysis-publish"]},
    {"@id": "lisa:runtime-classifier", "@type": "lisa:RuntimeModule", "label": "Classification pipeline", "description": "Validates complete researched model coverage and deterministically derives scoring/coverage before publication.", "source": ["lisa:src-classifier-scoring", "lisa:src-coverage"]},
    {"@id": "lisa:runtime-designer", "@type": "lisa:RuntimeModule", "label": "Offline design toolchain", "description": "Canonical model, Python/NetworkX routing, Draw.io/Mermaid sources, Node/resvg rendering, browser inspection and atomic current pointer.", "source": ["lisa:src-designer-skill", "lisa:src-design-finalization", "lisa:src-renderer-package"]},
    {"@id": "lisa:runtime-builder-validation", "@type": "lisa:RuntimeModule", "label": "Builder-specific reconciliation wrappers", "description": "Imported wrappers check classified components, planned coverage and future-platform contracts when the classification is found. CLI entry points bypass these wrappers; see R1.", "source": ["lisa:src-builder-validation", "lisa:src-builder-publication", "lisa:src-lifecycle-cli"]},
    {"@id": "lisa:runtime-evaluation-renderer", "@type": "lisa:RuntimeModule", "label": "Evaluation renderer and gate aggregation", "description": "Derives reports/baseline/aggregates from authored dataset, rubric and observations; checks complete test coverage and unsupported PASS claims.", "source": ["lisa:src-evaluation-renderer"]},
    {"@id": "lisa:runtime-gepa", "@type": "lisa:RuntimeModule", "label": "Resumable GEPA host bridge and outcome validator", "description": "Hash-bound candidate/request/response artifacts, budgets, frozen evaluation data, shadow-target isolation policy and verified final target impact. Host owns live operations.", "source": ["lisa:src-gepa-bridge", "lisa:src-gepa-policy", "lisa:src-gepa-outcome"]},
    {"@id": "lisa:runtime-artifact-composer", "@type": "lisa:RuntimeModule", "label": "Customer artifact composer", "description": "Deterministic composition/redaction and final hash inventory; upstream artifacts are read-only.", "source": ["lisa:src-generator-skill", "lisa:src-artifact-generation"]},
    {"@id": "lisa:runtime-publication-guard", "@type": "lisa:RuntimeModule", "label": "SharePoint publication guard", "description": "Selects current lifecycle files and one deployable ZIP, builds categorized manifest, and compares supplied remote inventory and metadata.", "source": ["lisa:src-publisher-package", "lisa:src-publication-verification"]},
    {"@id": "lisa:runtime-sharepoint-rest", "@type": "lisa:RuntimeModule", "label": "Authenticated SharePoint REST runner", "description": "Playwright-hosted browser code performs ZIP-first uploads, metadata propagation and read-back; browser authentication remains external.", "uses": "lisa:mcp-playwright", "source": ["lisa:src-sharepoint-rest", "lisa:src-publisher-skill"]},
    {"@id": "lisa:runtime-cleanup", "@type": "lisa:RuntimeModule", "label": "Consent-bound output cleanup", "description": "Inventories root/path/size/mtime state, validates exact DELETE OUTPUT and fingerprint, rejects reparse points, preserves the root and reports partial failures.", "source": ["lisa:src-cleanup-engine"]},
    {"@id": "lisa:runtime-video", "@type": "lisa:RuntimeModule", "label": "Standalone video initializer and production template", "description": "Refuses plugin-local or nonempty production targets; copies an isolated template with rendering and verification commands.", "source": ["lisa:src-video-initializer", "lisa:src-video-package", "lisa:src-video-skill"]},

    {"@id": "lisa:gate-classification-review", "@type": "lisa:Gate", "label": "Classification Accept/Revise/Cancel", "enforcement": "lisa:agent-directed", "description": "Must precede classification commit. Silence is not acceptance.", "source": ["lisa:src-human-reviews"]},
    {"@id": "lisa:gate-build-review", "@type": "lisa:Gate", "label": "Build Accept/Revise/Cancel", "enforcement": "lisa:agent-directed", "description": "Acceptance commits validated COMMITTED or BLOCKED status; BLOCKED cannot continue to evaluation.", "source": ["lisa:src-human-reviews"]},
    {"@id": "lisa:gate-design-inspection", "@type": "lisa:Gate", "label": "Hash-bound design inspection", "enforcement": ["lisa:code", "lisa:schema", "lisa:agent-directed"], "implementedBy": "lisa:runtime-designer", "description": "Code validates supplied inspection evidence; visual judgment and truthful evidence collection remain host-owned.", "source": ["lisa:src-design-finalization", "lisa:src-designer-skill"]},
    {"@id": "lisa:gate-remote-identity", "@type": "lisa:Gate", "label": "Remote target identity and reconciliation", "enforcement": "lisa:agent-directed", "description": "Verify correct authenticated target before writes; persist intent first and receipt after verified read-back.", "source": ["lisa:src-builder-skill", "lisa:src-optimizer-skill"]},
    {"@id": "lisa:gate-deployment", "@type": "lisa:Gate", "label": "Evaluator deployment decision", "contains": ["lisa:gate-judge", "lisa:gate-tool-use", "lisa:gate-groundedness", "lisa:gate-regression"], "hasStatusVocabulary": "lisa:evaluation-decisions", "enforcement": ["lisa:code", "lisa:schema", "lisa:agent-directed"], "implementedBy": "lisa:runtime-evaluation-renderer", "source": ["lisa:src-evaluator-skill", "lisa:src-evaluation-renderer"]},
    {"@id": "lisa:gate-judge", "@type": "lisa:Gate", "label": "LLM-as-Judge", "codeValue": "LLM_AS_JUDGE", "source": ["lisa:src-evaluation-renderer"]},
    {"@id": "lisa:gate-tool-use", "@type": "lisa:Gate", "label": "Tool Use", "codeValue": "TOOL_USE", "source": ["lisa:src-evaluation-renderer"]},
    {"@id": "lisa:gate-groundedness", "@type": "lisa:Gate", "label": "Groundedness", "codeValue": "GROUNDEDNESS", "source": ["lisa:src-evaluation-renderer"]},
    {"@id": "lisa:gate-regression", "@type": "lisa:Gate", "label": "Regression", "codeValue": "REGRESSION", "source": ["lisa:src-evaluation-renderer"]},
    {"@id": "lisa:gate-publication-proof", "@type": "lisa:Gate", "label": "Fresh publication proof", "enforcement": ["lisa:code", "lisa:agent-directed"], "implementedBy": ["lisa:runtime-publication-guard", "lisa:runtime-sharepoint-rest"], "description": "PUBLISHED requires fresh remote verification; local publication history cannot suppress remote reads.", "source": ["lisa:src-publisher-skill", "lisa:src-publication-verification"]},
    {"@id": "lisa:gate-cleanup-consent", "@type": "lisa:Gate", "label": "Exact cleanup consent and unchanged inventory", "enforcement": ["lisa:code", "lisa:agent-directed"], "implementedBy": "lisa:runtime-cleanup", "description": "Host obtains human consent; code checks supplied DELETE OUTPUT phrase and fingerprint before deletion.", "source": ["lisa:src-cleanup-skill", "lisa:src-cleanup-engine"]},

    {"@id": "lisa:platform-copilot-studio", "@type": "lisa:DeliveryPlatform", "label": "Microsoft Copilot Studio", "hasHarness": ["lisa:harness-standard", "lisa:harness-github-copilot", "lisa:harness-copilot-chat"], "source": ["lisa:src-builder-skill"]},
    {"@id": "lisa:platform-cowork", "@type": "lisa:DeliveryPlatform", "label": "Microsoft Cowork", "description": "Independent configuration/build target with null harness and no ZIP in cowork-configuration mode. No complete compatible CAD route is asserted.", "source": ["lisa:src-cowork-path", "lisa:src-build-modes"]},
    {"@id": "lisa:harness-standard", "@type": "lisa:Harness", "label": "Standard harness", "codeValue": "Standard", "source": ["lisa:src-builder-skill", "lisa:src-evaluator-skill"]},
    {"@id": "lisa:harness-github-copilot", "@type": "lisa:Harness", "label": "GitHub Copilot harness", "codeValue": "GitHub Copilot", "description": "Copilot Studio delivery runtime, not the GitHub Copilot CLI execution host.", "source": ["lisa:src-builder-skill", "lisa:src-evaluator-skill"]},
    {"@id": "lisa:harness-copilot-chat", "@type": "lisa:Harness", "label": "Copilot chat harness", "codeValue": "Copilot chat", "source": ["lisa:src-builder-skill", "lisa:src-evaluator-skill"]},
    {"@id": "lisa:platform-foundry", "@type": "lisa:ExternalSystem", "label": "Microsoft Foundry architecture option", "description": "Classifier research/design option and roadmap integration target; not a current builder implementation path. Classification code also uses the label Azure AI Foundry.", "source": ["lisa:src-platform-boundary", "lisa:src-builder-validation"]},
    {"@id": "lisa:platform-agent-framework", "@type": "lisa:ExternalSystem", "label": "Microsoft Agent Framework architecture option", "description": "Pro-code architecture/deferred integration option, not a current LISA build target.", "source": ["lisa:src-platform-boundary", "lisa:src-builder-validation"]},
    {"@id": "lisa:mcp-playwright", "@type": "lisa:McpServer", "label": "Playwright MCP", "codeValue": "playwright", "description": "Configured stdio browser integration using Edge; trusted local file access and authenticated sessions are separate responsibilities.", "source": ["lisa:src-mcp"]},
    {"@id": "lisa:mcp-azure", "@type": "lisa:McpServer", "label": "Azure MCP", "codeValue": "azure-mcp", "description": "Configured stdio research/tool integration; launcher uses the current npm latest package.", "source": ["lisa:src-mcp"]},
    {"@id": "lisa:mcp-learn", "@type": "lisa:McpServer", "label": "Microsoft Learn MCP", "codeValue": "ms-learn-mcp", "source": ["lisa:src-mcp"]},
    {"@id": "lisa:mcp-icm", "@type": "lisa:McpServer", "label": "Microsoft IcM MCP", "codeValue": "ms-icm-mcp", "description": "Internal research integration requiring a corporate identity; no customer incident data is included in this graph.", "source": ["lisa:src-mcp"]},
    {"@id": "lisa:mcp-enghub", "@type": "lisa:McpServer", "label": "Microsoft Engineering Hub MCP", "codeValue": "ms-eng-hub-mcp", "description": "Internal engineering research integration requiring a corporate identity.", "source": ["lisa:src-mcp"]},
    {"@id": "lisa:sharepoint-registry", "@type": "lisa:ExternalSystem", "label": "Configured SharePoint agent registry", "contains": ["lisa:destination-agent-library", "lisa:destination-artifact-library"], "source": ["lisa:src-config", "lisa:src-publisher-skill"]},
    {"@id": "lisa:destination-agent-library", "@type": "lisa:ExternalSystem", "label": "Agent Library destination", "description": "Configured document library receiving the deployable ZIP at its root before artifact-library writes.", "source": ["lisa:src-publisher-skill"]},
    {"@id": "lisa:destination-artifact-library", "@type": "lisa:ExternalSystem", "label": "Agent Artifact destination", "description": "Configured document library receiving an unchanged agent-name root folder and Agent-ID-linked manifest files.", "source": ["lisa:src-publisher-skill"]},

    {"@id": "lisa:runtime-installer", "@type": "lisa:RuntimeModule", "label": "Platform-aware repository installer", "uses": ["lisa:distribution", "lisa:runtime-prerequisites", "lisa:input-config"], "description": "Registers Copilot CLI or Agency after INSTALL PLUGIN confirmation, then optionally creates missing project folders and config without overwriting existing project data.", "source": ["lisa:src-install-registration", "lisa:src-project-setup"]},
    {"@id": "lisa:runtime-prerequisites", "@type": "lisa:RuntimeModule", "label": "Shared runtime probe and plugin prerequisite checker", "uses": ["lisa:prerequisite-python", "lisa:prerequisite-node", "lisa:prerequisite-powershell", "lisa:prerequisite-renderer"], "description": "Root setup and standalone plugin checks share runtime checks. Dependency restoration is separate from authentication.", "source": ["lisa:src-prerequisites", "lisa:src-plugin-prerequisites"]},
    {"@id": "lisa:prerequisite-python", "@type": "lisa:Prerequisite", "label": "Python and base packages", "versionConstraint": ">=3.11", "source": ["lisa:src-prerequisites", "lisa:src-requirements"]},
    {"@id": "lisa:prerequisite-node", "@type": "lisa:Prerequisite", "label": "Node.js, npm and npx", "versionConstraint": "Node.js >=20", "source": ["lisa:src-prerequisites"]},
    {"@id": "lisa:prerequisite-powershell", "@type": "lisa:Prerequisite", "label": "PowerShell", "versionConstraint": ">=7", "source": ["lisa:src-prerequisites"]},
    {"@id": "lisa:prerequisite-pac", "@type": "lisa:Prerequisite", "label": "Authenticated Power Platform CLI", "description": "Required for applicable cloud build/optimization paths; not a replacement for browser identity checks.", "source": ["lisa:src-builder-skill", "lisa:src-optimizer-skill"]},
    {"@id": "lisa:prerequisite-renderer", "@type": "lisa:Prerequisite", "label": "Offline designer renderer and layout dependencies", "description": "Locked Node/resvg renderer, bundled fonts and Python/NetworkX layout; restored during setup, not downloaded during a design run.", "source": ["lisa:src-designer-skill", "lisa:src-renderer-package", "lisa:src-requirements"]},
    {"@id": "lisa:prerequisite-gepa", "@type": "lisa:Prerequisite", "label": "Optional pinned GEPA dependency", "optional": true, "description": "Separate optimizer requirements and runtime policy; not installed by the base Python manifest.", "source": ["lisa:src-requirements", "lisa:src-gepa-policy"]},
    {"@id": "lisa:prerequisite-video", "@type": "lisa:Prerequisite", "label": "Optional isolated video toolchain", "optional": true, "description": "Production-local canvas/FFmpeg and narration dependencies. Online narration requires approved nonsensitive text and service authorization.", "source": ["lisa:src-video-package", "lisa:src-video-skill"]},
    {"@id": "lisa:tests-plugin", "@type": "lisa:TestSuite", "label": "Plugin repository test suite and CI", "description": "Discovers plugin tests and invokes stage, Node and renderer checks; validates packaging, setup and local behavior rather than live cloud success.", "source": ["lisa:src-test-runner", "lisa:src-ci", "lisa:src-plugin-tests", "lisa:src-config-parity"]},
