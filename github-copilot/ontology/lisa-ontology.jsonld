    {"@id": "lisa:finding-builder-cli", "@type": "lisa:ReviewFinding", "label": "R1: Builder CLI bypasses classifier reconciliation wrappers", "affects": ["lisa:runtime-builder-validation", "lisa:skill-agent-builder"], "description": "Imported validation/publication wrappers call classification reconciliation, but their __main__ paths invoke shared CLI helpers that directly call shared lifecycle functions. Do not model this reconciliation as an unconditional CLI guarantee.", "verification": "Existing builder fixture published locally, then referenced classification gained an unreconciled topology component. Imported validator rejected it; CLI validator returned exit 0 and status passed. Temporary fixture removed. No runtime fix made.", "source": ["lisa:src-builder-validation", "lisa:src-builder-publication", "lisa:src-lifecycle-cli"]},
    {"@id": "lisa:finding-cowork-route", "@type": "lisa:ReviewFinding", "label": "R2: Cowork configuration lacks compatible end-to-end CAD route", "affects": ["lisa:platform-cowork", "lisa:cad-workflow", "lisa:skill-agent-evaluator", "lisa:skill-artifact-publisher"], "description": "Cowork-only build schema requires null harness and no packages; evaluator requires a Copilot Studio harness and publisher requires a package. Router lacks an explicit Cowork-only terminal handoff. Build support is not full delivery support.", "verification": "Compared build/evaluation schemas, Cowork instructions, publication package selection and orchestrator route. No live Cowork run or runtime remediation performed.", "source": ["lisa:src-build-modes", "lisa:src-observations-schema", "lisa:src-publisher-package", "lisa:src-orchestrator", "lisa:src-cowork-path"]},

