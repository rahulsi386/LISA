{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stage", "runId", "status", "generatedAt", "configSha256", "artifacts"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "stage": {"const": "artifacts"},
    "runId": {"pattern": "^ART-[0-9]{8}-[0-9]{6}-[A-F0-9]{8}$"},
    "status": {"const": "passed"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "configSha256": {"pattern": "^[a-f0-9]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "sha256", "bytes"],
        "properties": {
          "relativePath": {"type": "string", "minLength": 1},
          "sha256": {"pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}