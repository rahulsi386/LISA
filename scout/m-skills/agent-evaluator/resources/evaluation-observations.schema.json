{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft-scout.local/schemas/evaluation-observations.schema.json",
  "title": "Agent evaluation observations",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "runId", "testSetId", "agent", "startedAt", "completedAt", "summary", "results", "gateSummary", "optimizerHandoff"],
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "runId": {"type": "string", "pattern": "^EVAL-[0-9]{8}-[0-9]{6}-[A-F0-9]{8}$"},
    "testSetId": {"type": "string", "minLength": 1},
    "agent": {
      "type": "object",
      "required": ["name", "agentId", "harness", "surface", "environmentId"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "agentId": {"type": "string", "minLength": 1},
        "harness": {"enum": ["GitHub Copilot", "Standard", "Copilot chat"]},
        "surface": {"type": "string", "minLength": 1},
        "environmentId": {"type": "string", "minLength": 1}
      }
    },
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "blocked", "notRun"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "notRun": {"type": "integer", "minimum": 0}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["testCaseId", "scenario", "userPrompt", "expectedResponse", "actualResponse", "status", "durationMs", "attempts", "playwrightObservations", "gateResults", "assertionResults", "failureReasons", "blocker"],
        "properties": {
          "testCaseId": {"type": "string", "pattern": "^EVAL-[0-9]{3,}$"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
          "durationMs": {"type": "integer", "minimum": 0},
          "attempts": {"type": "integer", "minimum": 1},
          "playwrightObservations": {
            "type": "object",
            "required": ["conversationReset", "responseCompleted", "surfaceUsed", "citationsObserved", "toolActivityObserved", "uiErrors", "sideEffectsObserved", "evidence", "notes"],
            "properties": {
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^evidence/EVAL-[0-9]{3,}-attempt-[0-9]{2}\\.(png|jpg|jpeg|json)$"
                }
              }
            }
          }
        }
      }
    },
    "gateSummary": {"type": "object"},
    "optimizerHandoff": {
      "type": "object",
      "required": ["evaluationDecision", "eligibleForOptimization", "findings"],
      "properties": {
        "evaluationDecision": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
        "eligibleForOptimization": {"type": "boolean"},
        "findings": {"type": "array"}
      }
    }
  }
}
