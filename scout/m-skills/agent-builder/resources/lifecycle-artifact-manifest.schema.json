{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft-scout.local/schemas/lifecycle-artifact-manifest.schema.json",
  "title": "Agent lifecycle artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "runId",
    "generatedAt",
    "status",
    "rootFolder",
    "agent",
    "sourceRuns",
    "artifacts",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "stage": {
      "enum": [
        "build",
        "evaluation",
        "optimization"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^(BLD|EVAL|OPT)-[0-9]{8}-[0-9]{6}-[A-F0-9]{8}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "prepared",
        "in-progress",
        "complete",
        "pass",
        "fail",
        "blocked",
        "rolled-back"
      ]
    },
    "rootFolder": {
      "enum": [
        "build",
        "evaluation",
        "optimization"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "agentId",
        "agenticPlatform",
        "harness",
        "environmentId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "agenticPlatform": {
          "enum": [
            "Microsoft Copilot Studio",
            "Microsoft Cowork"
          ]
        },
        "schemaName": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "enum": [
            "GitHub Copilot",
            "Standard",
            "Copilot chat",
            null
          ]
        },
        "environmentId": {
          "type": "string",
          "minLength": 1
        },
        "environmentUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"agenticPlatform": {"const": "Microsoft Cowork"}}},
          "then": {"properties": {"harness": {"const": null}}}
        },
        {
          "if": {"properties": {"agenticPlatform": {"const": "Microsoft Copilot Studio"}}},
          "then": {"properties": {"harness": {"enum": ["GitHub Copilot", "Standard", "Copilot chat"]}}}
        }
      ]
    },
    "sourceRuns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(BLD|EVAL|OPT)-[0-9]{8}-[0-9]{6}-[A-F0-9]{8}$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "relativePath",
          "kind",
          "required",
          "sha256",
          "bytes",
          "schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+)?$"
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)|^[A-Za-z]:|^[\\\\/]"
            }
          },
          "kind": {
            "enum": [
              "json",
              "markdown",
              "csv",
              "image",
              "package",
              "directory",
              "source",
              "other"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
